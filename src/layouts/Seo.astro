---
// Plantilla de las páginas SEO (ciudades e índice de ciudades)
const { title, description, path, jsonLd, withMap = false } = Astro.props;
const url = new URL(path, Astro.site).href;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <link rel="icon" href="/favicon-96.png?v=2" type="image/png" sizes="96x96">
    <link rel="icon" href="/favicon-192.png?v=2" type="image/png" sizes="192x192">
    <link rel="shortcut icon" href="/favicon.ico?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="theme-color" content="#16a34a">
    <link rel="canonical" href={url}>
    <meta name="geo.region" content="EC">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="es_EC">
    <meta property="og:site_name" content="EvCarga Ecuador">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://evcarga.github.io/favicon-512.png">
    <meta name="twitter:card" content="summary">
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    {withMap && <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <style is:global>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .leaflet-container { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="text-slate-700 pb-24">
    <nav class="bg-white/90 backdrop-blur shadow-sm p-4 sticky top-0 z-[1000] border-b border-slate-100">
        <div class="container mx-auto flex justify-between items-center">
            <a href="/" class="flex items-center gap-3">
                <img src="/favicon-96.png" alt="EvCarga" width="36" height="36" class="rounded-lg">
                <span class="text-2xl font-bold text-slate-800 tracking-tight">EvCar</span>
            </a>
            <a href="/cargadores.html" class="text-sm font-medium text-slate-500 hover:text-green-600">Ciudades</a>
        </div>
    </nav>
    <slot />
    <footer class="bg-slate-900 text-slate-400 text-xs text-center py-6 px-4 mt-12">
        <p>© EvCarga Ecuador · Cargadores para carros eléctricos e instalación de cargadores en Ecuador · <a href="https://wa.me/593980407829" class="text-green-400 hover:underline" target="_blank" rel="noopener">WhatsApp +593 98 040 7829</a> · <a href="/privacidad.html" class="text-green-400 hover:underline">Privacidad y Términos</a></p>
    </footer>
</body>
</html>
