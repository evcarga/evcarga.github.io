---
// Página para compartir una publicación (/p/<id>.html): WhatsApp lee la imagen, el título y la descripción
import { getApprovedListings, priceText } from '../../lib/market.js';

export async function getStaticPaths() {
  return (await getApprovedListings()).map((l) => ({ params: { id: String(l.id) }, props: { listing: l } }));
}

const { listing: l } = Astro.props;
const url = new URL(`/p/${l.id}.html`, Astro.site).href;
const image = new URL(`/p/${l.id}.jpg`, Astro.site).href;
const price = priceText(l.price);
const title = `${l.title} · ${price} | Marketplace EvCarga`;
const desc = [l.description, l.city].filter(Boolean).join(' · ').replace(/\s+/g, ' ').slice(0, 200) || 'Publicación en el marketplace de EvCarga Ecuador.';
const open = `/entorno.html?p=${l.id}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={desc}>
    <link rel="canonical" href={url}>
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <meta property="og:type" content="product">
    <meta property="og:locale" content="es_EC">
    <meta property="og:site_name" content="EvCarga Ecuador">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={`${l.title} · ${price}`}>
    <meta property="og:description" content={desc}>
    <meta property="og:image" content={image}>
    <meta property="og:image:secure_url" content={image}>
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={l.title}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`${l.title} · ${price}`}>
    <meta name="twitter:description" content={desc}>
    <meta name="twitter:image" content={image}>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style is:global>body { font-family: 'Inter', sans-serif; background: #f8fafc; }</style>
</head>
<body class="text-slate-700 pb-24">
    <nav class="bg-white shadow-sm border-b border-slate-100">
        <div class="max-w-xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center gap-2"><img src="/favicon-96.png?v=2" alt="EvCarga" width="32" height="32" class="rounded-lg"><span class="text-lg font-bold text-slate-800">EvCar</span></a>
            <a href="/entorno.html#market" class="text-sm font-semibold text-green-700">Marketplace →</a>
        </div>
    </nav>
    <main class="max-w-xl mx-auto px-4 mt-4">
        <article class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <a href={open}><img src={l.images?.[0] || '/favicon-512.png'} alt={l.title} class="w-full aspect-[4/3] object-cover bg-slate-100"></a>
            <div class="p-4 space-y-2">
                {l.is_company && <span class="inline-block bg-blue-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-full">🏢 {l.company_name || 'Empresa'}</span>}
                <div class="flex justify-between gap-3 items-start">
                    <h1 class="text-xl font-bold text-slate-800 leading-tight">{l.title}</h1>
                    <span class="text-xl font-extrabold text-green-700 whitespace-nowrap">{price}</span>
                </div>
                <p class="text-xs text-slate-500">{[l.kind === 'servicio' ? 'Servicio' : 'Producto', l.category, l.city].filter(Boolean).join(' · ')}</p>
                {l.description && <p class="text-sm text-slate-700 whitespace-pre-line">{l.description}</p>}
                <div class="bg-slate-50 border border-dashed border-slate-300 rounded-xl p-3 text-center text-sm text-slate-600">
                    🔒 Para ver el contacto del vendedor, regístrate gratis en EvCarga.
                </div>
                <a href={open} class="block w-full bg-green-600 text-white text-center py-3 rounded-xl font-bold hover:bg-green-700">Ver fotos y contactar</a>
            </div>
        </article>
    </main>
</body>
</html>
