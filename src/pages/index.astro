            (err) => { console.warn('Ubicación no disponible al inicio:', err.message); },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 5 * 60 * 1000 }
        );
    }

    function placeUserMarker(map, coords) {
        if (userLocationMarker) map.removeLayer(userLocationMarker);
        const userIcon = L.divIcon({
            className: 'user-location-pin-container',
            html: `<div class="user-location-pin">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.22.42-1.42 1.01L3 12v7.5c0 .83.67 1.5 1.5 1.5S6 20.33 6 19.5V19h12v.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V12l-2.08-5.99zM7.5 16.5C6.67 16.5 6 15.83 6 15s.67-1.5 1.5-1.5S9 14.17 9 15s-.67 1.5-1.5 1.5zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                        <path d="M0 0h24v24H0z" fill="none"/>
                    </svg>
                   </div>`,
            iconSize: [36, 42],
            iconAnchor: [18, 42],
            popupAnchor: [0, -40]
        });
        userLocationMarker = L.marker([coords.lat, coords.lng], { icon: userIcon, zIndexOffset: 1000 }).addTo(map);
        userLocationMarker.bindPopup("<b>📍 Estás aquí</b>");
    }

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }

    function formatPrice(value, suffix) {
        if (value === null || value === undefined || value === '' || isNaN(parseFloat(value))) return 'N/D';
        return `$${parseFloat(value).toFixed(2)}${suffix || ''}`;
    }

    function normalize(str) {
        return (str || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    }

    // Potencia máxima en kW del texto (ej. "7 kW / 60 kW" -> 60)
    function maxKw(power) {
        const nums = [...String(power || '').matchAll(/(\d+(?:[.,]\d+)?)\s*kw/gi)].map(m => parseFloat(m[1].replace(',', '.')));
        return nums.length ? Math.max(...nums) : 0;
    }
    function isFastCharger(c) { return maxKw(c.power) >= 50; }

    function createModernIcon(status, fast = false) {
        return L.divIcon({
            className: 'custom-div-icon',
            html: `<div class="marker-pin ${status === 'OCUPADO' ? 'occupied' : (fast ? 'fast' : '')}"></div>`,
            iconSize: [34, 42],
            iconAnchor: [17, 42],
            popupAnchor: [0, -40],
            shadowUrl: null,
            shadowSize: null,
            shadowAnchor: null
        });
    }

    // ================= MAPAS =================
    function openMainMap() {
        document.getElementById('modal-main-map').classList.add('active');
        
        setTimeout(() => {
            if (!mainMap) {
                const center = userCoords ? [userCoords.lat, userCoords.lng] : [-1.8312, -78.1834];
                const zoom = userCoords ? 14 : 6;
                mainMap = L.map('main-map').setView(center, zoom);
                mainMap.__centeredOnUser = !!userCoords;
                addBaseTiles(mainMap);
                
                L.control.scale({ position: 'bottomleft', metric: true, imperial: false }).addTo(mainMap);
                
                if (typeof L.control.locate === 'function') {
                    L.control.locate({
                        position: 'bottomright',
                        strings: { title: 'Mi ubicación' },
                        locateOptions: { enableHighAccuracy: true, maxZoom: 16 },
                        flyTo: true,
                        drawCircle: true,
                        showPopup: true
                    }).addTo(mainMap);
                }

                chargersData.forEach(c => addPinToMainMap(c));
                if (userCoords) placeUserMarker(mainMap, userCoords);
            }
            mainMap.invalidateSize();
        }, 200);
    }

    // ========= AQUÍ ESTÁ LA FUNCIÓN OPTIMIZADA DEL POPUP =========
    function fillMapSearchOptions() {
        const names = new Set();
        chargersData.forEach(c => {
            if (c.provincia) names.add(c.provincia.trim());
            if (c.city) names.add(c.city.trim());
        });
        document.getElementById('map-search-options').innerHTML =
            [...names].sort((a, b) => a.localeCompare(b)).map(n => `<option value="${escapeHtml(n)}">`).join('');
    }

    // Al elegir una sugerencia de la lista, buscar de inmediato
    document.getElementById('map-search').addEventListener('input', (e) => {
        const v = normalize(e.target.value.trim());
        const opts = [...document.querySelectorAll('#map-search-options option')].map(o => normalize(o.value));
        if (v && opts.includes(v) && (e.inputType === 'insertReplacementText' || !e.inputType)) searchMap();
    });
    document.getElementById('map-search').addEventListener('change', () => searchMap());

    async function searchMap() {
        const raw = document.getElementById('map-search').value.trim();
        const term = normalize(raw);
        if (!term || !mainMap) return;
        // evita repetir la misma búsqueda (input + change + submit)
        if (searchMap.last === term && Date.now() - searchMap.at < 1500) return;
        searchMap.last = term; searchMap.at = Date.now();
        document.getElementById('map-search').blur();
        // 1) Cargadores de esa provincia o ciudad
        const matches = chargersData.filter(c => c.lat && c.lng && (normalize(c.provincia) === term || normalize(c.city) === term));
        const list = matches.length ? matches : chargersData.filter(c => c.lat && c.lng && (normalize(c.provincia).includes(term) || normalize(c.city).includes(term)));
        if (list.length) {
            const bounds = L.latLngBounds(list.map(c => [c.lat, c.lng]));
            mainMap.flyToBounds(bounds.pad(0.2), { maxZoom: 14, duration: 1 });
            return;
        }
        // 2) Sin cargadores: ubicar el lugar en Ecuador
        try {
            const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=ec&q=${encodeURIComponent(raw)}`);
            const results = await res.json();
            if (!results.length) return alert('No se encontró ese lugar en Ecuador.');
            mainMap.flyTo([parseFloat(results[0].lat), parseFloat(results[0].lon)], 12, { duration: 1 });
            setTimeout(() => alert('Aún no hay cargadores registrados en ' + raw + '.'), 1100);
        } catch (e) { alert('Error buscando el lugar. Intenta de nuevo.'); }
    }

    function addPinToMainMap(c) {
        if(!c.lat || !c.lng) return;
        
        const fast = isFastCharger(c);
        const m = L.marker([c.lat, c.lng], { icon: createModernIcon(c.status, fast), zIndexOffset: fast ? 500 : 0 }).addTo(mainMap);
        
        const isOccupied = c.status === 'OCUPADO';
        const statusColor = isOccupied ? 'text-red-600' : 'text-green-600';
        const statusText = isOccupied ? 'OCUPADO' : 'DISPONIBLE';

        const mapsUrl = c.link ? c.link : `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}`;

        const phone = c.contact_phone || c.profiles?.phone;
        const waNumber = phone ? phone.replace(/\D/g, '').replace(/^0/, '593') : '';
        const contactHTML = !currentUser
            ? `<button onclick="closeModal('modal-main-map');openModal('modal-register')" class="mt-1.5 w-full bg-slate-800 hover:bg-slate-900 !text-white font-semibold text-[11px] py-1.5 rounded-lg">🔒 Regístrate para ver el contacto</button>
               <button onclick="closeModal('modal-main-map');openModal('modal-login')" class="mt-1 w-full text-[10px] text-slate-500 hover:underline">¿Ya tienes cuenta? Ingresar</button>`
            : (phone
                ? `<p class="mt-1.5 text-[11px] text-slate-500">Contacto: <b class="text-slate-800">${escapeHtml(phone)}</b></p>
                   <div class="mt-1 grid grid-cols-2 gap-1">
                       <a href="tel:${escapeHtml(phone)}" class="bg-green-600 hover:bg-green-700 !text-white font-semibold text-[11px] py-1.5 rounded-lg">📞 Llamar</a>
                       <a href="https://wa.me/${escapeHtml(waNumber)}?text=${encodeURIComponent('Hola, te escribo por tu cargador en EvCarga: ' + (c.title || ''))}" target="_blank" rel="noopener" class="bg-emerald-500 hover:bg-emerald-600 !text-white font-semibold text-[11px] py-1.5 rounded-lg">💬 WhatsApp</a>
                   </div>`
                : `<p class="mt-1.5 text-[10px] text-slate-400 italic">Sin teléfono de contacto registrado.</p>`);

        m.bindPopup(`
            <div class="text-center" style="width: 190px;">
                <h3 class="font-bold text-slate-800 text-sm leading-tight">${escapeHtml(c.title)}</h3>
                <p class="text-[10px] font-bold ${statusColor} uppercase tracking-wide mt-0.5">${statusText}${fast ? ' · <span class="text-blue-600">⚡ Carga rápida</span>' : ''}</p>
                <div class="text-left text-[11px] bg-slate-50 px-2 py-1.5 rounded-lg border border-slate-200 text-slate-600 mt-1.5 space-y-0.5">
                    <p>⚡ ${escapeHtml(c.power)} · ${escapeHtml(c.charger_type)}</p>
                    <p>💰 ${formatPrice(c.price_kwh, '/kWh')}${c.price_parking ? ` · 🅿️ ${formatPrice(c.price_parking, '/h')}` : ''}</p>
                    ${c.schedule ? `<p>🕒 ${escapeHtml(c.schedule)}</p>` : ''}
                </div>
                <a href="${escapeHtml(mapsUrl)}" target="_blank" rel="noopener" class="mt-1.5 w-full block bg-blue-600 hover:bg-blue-700 !text-white font-semibold text-[11px] py-1.5 rounded-lg">📍 Cómo llegar</a>
                ${contactHTML}
            </div>
        `, { autoPanPaddingTopLeft: [10, 110], autoPanPaddingBottomRight: [10, 20] });
    }

    function locateUserOnMainMap() {
        if (!navigator.geolocation) { alert("Tu navegador no soporta geolocalización."); return; }
        navigator.geolocation.getCurrentPosition(
            (pos) => {
                userCoords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                if (mainMap) {
                    mainMap.flyTo([userCoords.lat, userCoords.lng], 15, { duration: 1.5 });
                    mainMap.__centeredOnUser = true;
                    placeUserMarker(mainMap, userCoords);
                    userLocationMarker.openPopup();
                }
            },
            (error) => { console.warn("No se pudo obtener la ubicación automática:", error.message); alert("No pudimos obtener tu ubicación. Verifica los permisos del navegador."); },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    function openPickerMap() {
        document.getElementById('modal-picker').classList.add('active');
        setTimeout(() => {
            if (!pickerMap) {
                pickerMap = L.map('picker-map').setView([-0.175709, -78.485581], 13);
                addBaseTiles(pickerMap);
                pickerMap.on('click', e => {
                    if(pickerMarker) pickerMap.removeLayer(pickerMarker);
                    pickerMarker = L.marker(e.latlng, { icon: createModernIcon('DISPONIBLE') }).addTo(pickerMap);
                    tempPickerCoords = e.latlng;
                });
            }
            pickerMap.invalidateSize();
        }, 200);
    }

    let offerPreviewMap, offerPreviewMarker;
    function showOfferPreviewMap(lat, lng) {
        const wrap = document.getElementById('offer-preview-map');
        wrap.style.display = 'block';
        setTimeout(() => {
            if (!offerPreviewMap) {
                offerPreviewMap = L.map('offer-preview-map', { zoomControl: false, dragging: false, scrollWheelZoom: false }).setView([lat, lng], 15);
                addBaseTiles(offerPreviewMap);
            } else {
                offerPreviewMap.setView([lat, lng], 15);
            }
            if (offerPreviewMarker) offerPreviewMap.removeLayer(offerPreviewMarker);
            offerPreviewMarker = L.marker([lat, lng], { icon: createModernIcon('DISPONIBLE') }).addTo(offerPreviewMap);
            offerPreviewMap.invalidateSize();
        }, 150);
    }

    function confirmPickerLocation() {
        if(tempPickerCoords) {
            document.getElementById('offer-lat').value = tempPickerCoords.lat;
            document.getElementById('offer-lng').value = tempPickerCoords.lng;
            document.getElementById('location-status').innerHTML = `<span class="text-green-600 font-bold flex justify-center items-center gap-1">✓ Ubicación Fijada</span>`;
            showOfferPreviewMap(tempPickerCoords.lat, tempPickerCoords.lng);
            closeModal('modal-picker');
        } else alert("Por favor selecciona un punto en el mapa");
    }

    function locateUserOnPicker() {
        if (!navigator.geolocation) { alert("GPS no soportado en este dispositivo"); return; }
        navigator.geolocation.getCurrentPosition(
            pos => {
                const latlng = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                tempPickerCoords = latlng;
                pickerMap.setView(latlng, 16);
                if (pickerMarker) pickerMap.removeLayer(pickerMarker);
                pickerMarker = L.marker(latlng, { icon: createModernIcon('DISPONIBLE') }).addTo(pickerMap);
            },
            (err) => { console.error(err); alert("No pudimos obtener tu ubicación GPS. Verifica permisos."); },
            { enableHighAccuracy: true }
        );
    }

    async function searchPickerLocation() {
        const query = document.getElementById('picker-search').value.trim();
        if (!query) return;
        try {
            const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`);
            const results = await res.json();
            if (!results.length) { alert("No se encontró ese lugar. Prueba con otro nombre."); return; }
            const latlng = { lat: parseFloat(results[0].lat), lng: parseFloat(results[0].lon) };
            tempPickerCoords = latlng;
            pickerMap.setView(latlng, 15);
            if (pickerMarker) pickerMap.removeLayer(pickerMarker);
            pickerMarker = L.marker(latlng, { icon: createModernIcon('DISPONIBLE') }).addTo(pickerMap);
        } catch (err) {
            console.error(err);
            alert("Error buscando el lugar. Intenta de nuevo.");
        }
    }

    function locateUserForForm() {
        document.getElementById('location-status').innerText = "Buscando satélites...";
        if (!navigator.geolocation) { document.getElementById('location-status').innerText = "GPS no soportado"; return; }

        navigator.geolocation.getCurrentPosition(
            pos => {
                document.getElementById('offer-lat').value = pos.coords.latitude;
                document.getElementById('offer-lng').value = pos.coords.longitude;
                document.getElementById('location-status').innerHTML = `<span class="text-green-600 font-bold flex justify-center items-center gap-1">✓ GPS Fijado (Precisión: ${Math.round(pos.coords.accuracy)}m)</span>`;
                showOfferPreviewMap(pos.coords.latitude, pos.coords.longitude);
            }, 
            (err) => {
                console.error(err);
                document.getElementById('location-status').innerText = "Error GPS, usa el mapa manual";
                alert("No pudimos obtener tu ubicación GPS. Verifica permisos.");
            },
            { enableHighAccuracy: true }
        );
    }

    // ================= UI & AUTH =================
    async function checkSession() {
        const { data: { session } } = await _supabase.auth.getSession();
        currentUser = session?.user || null;
        updateUI();
    }

    async function updateUI() {
        const nav = document.getElementById('nav-buttons');
        const btnHero = document.getElementById('btn-offer-hero');
        const nameDisplay = document.getElementById('user-display-name');

        if (currentUser) {
            const { data } = await _supabase.from('profiles').select('full_name, role, phone, consent_email, consent_whatsapp, consent_updated_at, terms_accepted_at').eq('id', currentUser.id).single();
            currentProfile = data;
            const displayName = data?.full_name || currentUser.user_metadata?.full_name || currentUser.email;
            if(displayName) {
                nameDisplay.innerText = `Hola, ${displayName}`;
                nameDisplay.classList.remove('hidden');
            }
            nav.innerHTML = `
                ${data?.role === 'admin' ? '<a href="admin.html" class="text-slate-500 hover:text-green-600 font-medium transition mr-2 text-xs sm:text-sm">Admin</a>' : ''}
                <button onclick="openConsent()" class="text-slate-500 hover:text-green-600 font-medium transition mr-2 text-xs sm:text-sm" title="Permisos para recibir información">🔔 Avisos</button>
                <button onclick="openModal('modal-my-chargers');loadMyChargers()" class="text-slate-500 hover:text-green-600 font-medium transition mr-2 text-xs sm:text-sm">Mis Cargadores</button>
                <button onclick="logout()" class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg text-xs sm:text-sm hover:bg-slate-200 font-bold transition">Salir</button>
            `;
            btnHero.classList.remove('hidden');
            btnHero.classList.add('flex');
            // Google no entrega celular ni aceptación: se piden antes de continuar
            if (data && (!data.phone || !data.terms_accepted_at)) openCompleteProfile(data);
        } else {
            nameDisplay.classList.add('hidden');
            nav.innerHTML = `
                <button onclick="openModal('modal-login')" class="text-slate-500 hover:text-slate-800 font-medium mr-2 text-xs sm:text-sm">Ingresar</button>
                <button onclick="openModal('modal-register')" class="bg-green-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-green-700 transition shadow-md text-xs sm:text-sm">Registro</button>
            `;
            btnHero.classList.add('hidden');
            btnHero.classList.remove('flex');
        }
        loadChargers();
    }

    // ================= DATOS (CARGADORES) =================
    async function loadChargers() {
        // Los visitantes sin sesión no tienen acceso al teléfono (restringido en Supabase)
        const cols = 'id,user_id,title,city,address,charger_type,power,price_kwh,price_parking,parking_type,schedule,lat,lng,status,occupied_until,created_at,link,provincia,region,requires_app,community_only';
        const { data, error } = await _supabase.from('chargers').select(currentUser ? `${cols},contact_phone,profiles(full_name, phone)` : cols);
        if(error) { console.error(error); return; }
        chargersData = data || [];
        fillMapSearchOptions();
        document.getElementById('count-chargers').innerText = `${chargersData.length} activos`;
        applyFilter(); // respeta el filtro de ciudad (p. ej. al venir de /cargadores/<ciudad>.html)
        
        if(mainMap) {
            mainMap.eachLayer((layer) => { 
                if(layer instanceof L.Marker && layer !== userLocationMarker) mainMap.removeLayer(layer); 
            });
            chargersData.forEach(c => addPinToMainMap(c));
        }
    }

    function renderChargers(list) {
        const container = document.getElementById('chargers-list');
        const btnContainer = document.getElementById('load-more-container');
        container.innerHTML = '';

        if(list.length === 0) {
            container.innerHTML = `
                <div class="col-span-1 md:col-span-3 text-center py-12 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                    <div class="text-5xl mb-4 opacity-50">🌱</div>
                    <h3 class="text-lg font-bold text-slate-700">No hay cargadores aquí</h3>
                    <p class="text-slate-500 text-sm">Intenta otra ciudad o sé el primero.</p>
                </div>`;
            btnContainer.classList.add('hidden');
            return;
        }

        const visibleItems = list.slice(0, itemsLimit);

        visibleItems.forEach(c => {
            const isOccupied = c.status === 'OCUPADO';
            let statusHTML = isOccupied 
                ? `<span class="inline-flex items-center bg-red-50 text-red-600 text-[10px] font-extrabold px-2 py-1 rounded-full border border-red-100 tracking-wide">OCUPADO</span>`
                : `<span class="inline-flex items-center bg-green-50 text-green-600 text-[10px] font-extrabold px-2 py-1 rounded-full border border-green-100 tracking-wide">DISPONIBLE</span>`;

            const card = document.createElement('div');
            card.className = 'bg-white rounded-xl shadow-sm border border-green-500 overflow-hidden card-hover transition duration-300 cursor-pointer flex flex-col h-full group hover:border-green-500';
            card.onclick = (e) => {
                if(e.target.tagName === 'A' || e.target.tagName === 'BUTTON') return;
                openDetailModal(c.id);
            };

            card.innerHTML = `
                <div class="p-4 flex-grow relative">
                    <div class="flex justify-between items-start mb-3">
                        <h4 class="font-bold text-base text-slate-800 leading-tight truncate pr-2 group-hover:text-green-700 transition">${escapeHtml(c.title)}</h4>
                        ${statusHTML}
                    </div>
                    <div class="flex items-center text-slate-500 text-xs mb-4">
                        <span class="mr-1">📍</span> 
                        <span class="truncate font-medium">${escapeHtml(c.city)}</span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-2 mb-0">
                        <div class="bg-slate-50 p-2 rounded text-center border border-slate-100">
                            <p class="text-[10px] text-slate-400 uppercase font-bold">Energía</p>
                            <p class="font-bold text-slate-700">${formatPrice(c.price_kwh)}</p>
                        </div>
                        <div class="bg-slate-50 p-2 rounded text-center border border-slate-100">
                            <p class="text-[10px] text-slate-400 uppercase font-bold">Potencia</p>
                            <p class="font-bold text-slate-700 text-sm truncate" title="${escapeHtml(c.power)}">${escapeHtml(c.power)}</p>
                        </div>
                    </div>
                </div>
                <div class="bg-slate-50 p-3 border-t border-slate-100 flex justify-center">
                    <span class="text-xs font-bold text-slate-400 group-hover:text-green-600 transition">Ver detalles completos →</span>
                </div>
            `;
            container.appendChild(card);
        });

        if (itemsLimit >= list.length) {
            btnContainer.classList.add('hidden');
        } else {
            btnContainer.classList.remove('hidden');
        }
    }

    function openDetailModal(id) {
        const c = chargersData.find(item => item.id === id);
        if(!c) return;

        document.getElementById('detail-title').innerText = c.title || '';
        document.getElementById('detail-city').innerText = c.city || '';
        document.getElementById('detail-address').innerText = c.address || '';
        document.getElementById('detail-type').innerText = c.charger_type || 'No especificado';
        document.getElementById('detail-power').innerText = c.power || 'No especificado';
        document.getElementById('detail-parking-type').innerText = c.parking_type || 'No especificado';
        document.getElementById('detail-price-kwh').innerText = formatPrice(c.price_kwh, '/kwh');
        document.getElementById('detail-price-parking').innerText = formatPrice(c.price_parking, '/h');
        document.getElementById('detail-schedule').innerText = c.schedule || 'No especificado';

        const banner = document.getElementById('detail-status-banner');
        if(c.status === 'OCUPADO') {
            const until = c.occupied_until ? new Date(c.occupied_until).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : 'hora no definida';
            banner.className = "bg-red-50 text-red-700 p-3 rounded-lg font-bold text-center border border-red-100 text-xs";
            banner.innerText = `⛔ OCUPADO HASTA: ${until}`;
        } else {
            banner.className = "bg-green-50 text-green-700 p-3 rounded-lg font-bold text-center border border-green-100 text-xs";
            banner.innerText = "✅ DISPONIBLE AHORA";
        }

        const actions = document.getElementById('detail-action-buttons');
        const phone = c.contact_phone || c.profiles?.phone;
        const contactBtn = (currentUser && phone)
            ? `<a href="tel:${escapeHtml(phone)}" class="w-full bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700 text-center shadow block transition flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg> Llamar al dueño</a>`
            : (currentUser
                ? `<p class="text-xs text-center text-slate-400 italic">Este punto no tiene teléfono de contacto registrado.</p>`
                : `<button onclick="closeModal('modal-detail');openModal('modal-login')" class="w-full bg-slate-200 text-slate-600 py-3 rounded-lg font-bold hover:bg-slate-300 text-center block transition text-xs">Inicia Sesión para Contactar</button>`);
        
        const mapsUrl = c.link ? c.link : (c.lat && c.lng ? `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}` : null);
        
        actions.innerHTML = `
            ${mapsUrl ? `<a href="${escapeHtml(mapsUrl)}" target="_blank" rel="noopener" class="w-full bg-white text-blue-600 border border-blue-200 py-3 rounded-lg font-bold hover:bg-blue-50 text-center block transition mb-2 shadow-sm flex items-center justify-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg> Navegar con Google Maps</a>` : ''}
            ${contactBtn}
        `;

        openModal('modal-detail');

        setTimeout(() => {
            if(detailMap) { detailMap.remove(); detailMap = null; }
            const dmapEl = document.getElementById('detail-map');
            if (c.lat && c.lng) {
                dmapEl.style.display = '';
                detailMap = L.map('detail-map', {zoomControl: false, attributionControl: false}).setView([c.lat, c.lng], 15);
                addBaseTiles(detailMap);
                L.marker([c.lat, c.lng], { icon: createModernIcon(c.status) }).addTo(detailMap);
            } else {
                dmapEl.style.display = 'none';
            }
        }, 200);
    }

    // ================= GESTIÓN MIS CARGADORES =================
    async function loadMyChargers() {
        if(!currentUser) return;
        const { data } = await _supabase.from('chargers').select('*').eq('user_id', currentUser.id);
        const container = document.getElementById('my-chargers-container');
        container.innerHTML = '';
        
        if(!data || data.length === 0) {
            container.innerHTML = '<div class="text-center py-8 text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200"><p class="italic">Aún no has publicado cargadores.</p></div>';
            return;
        }

        data.forEach(c => {
            const item = document.createElement('div');
            item.className = "bg-white rounded-xl p-4 border border-slate-200 shadow-sm";
            
            if(c.status === 'DISPONIBLE') {
                item.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <h4 class="font-bold text-slate-800">${escapeHtml(c.title)}</h4>
                        <span class="bg-green-100 text-green-800 text-[10px] font-bold px-2 py-1 rounded-full">ACTIVO</span>
                    </div>
                    <div class="mt-3 bg-slate-50 p-3 rounded-lg border border-slate-100">
                        <label class="text-[10px] font-bold text-slate-400 uppercase block mb-2">Marcar Ocupado Hasta:</label>
                        <div class="flex gap-2">
                            <input type="datetime-local" id="date-${c.id}" class="flex-grow border border-slate-200 bg-white p-2 rounded text-sm outline-none focus:border-red-400">
                            <button onclick="setStatus(${c.id}, 'OCUPADO')" class="bg-red-500 text-white text-xs px-4 py-2 rounded font-bold hover:bg-red-600 transition shadow-sm">BLOQUEAR</button>
                        </div>
                    </div>
                `;
            } else {
                const occupiedDate = c.occupied_until ? new Date(c.occupied_until).toLocaleString([], {dateStyle: 'short', timeStyle: 'short'}) : 'Sin definir';
                item.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <h4 class="font-bold text-slate-800">${escapeHtml(c.title)}</h4>
                        <span class="bg-red-100 text-red-800 text-[10px] font-bold px-2 py-1 rounded-full">OCUPADO</span>
                    </div>
                    <div class="mt-2 p-3 bg-red-50 rounded-lg border border-red-100 flex justify-between items-center">
                        <span class="text-xs font-bold text-red-700">Hasta: ${occupiedDate}</span>
                        <button onclick="setStatus(${c.id}, 'DISPONIBLE')" class="bg-green-500 text-white text-xs px-4 py-2 rounded font-bold hover:bg-green-600 transition shadow-sm">LIBERAR</button>
                    </div>
                `;
            }
            container.appendChild(item);
        });
    }

    async function setStatus(id, status) {
        let payload = { status: status };
        if(status === 'OCUPADO') {
            const dateVal = document.getElementById(`date-${id}`).value;
            if(!dateVal) return alert("⚠️ Por favor selecciona fecha y hora.");
            payload.occupied_until = new Date(dateVal).toISOString();
        } else {
            payload.occupied_until = null;
        }

        const { error } = await _supabase.from('chargers').update(payload).eq('id', id);
        if(error) alert(error.message);
        else { loadMyChargers(); loadChargers(); }
    }

    // ================= PUBLICAR =================
    async function postCharger(e) {
        e.preventDefault();
        if(!currentUser) return alert("Inicia sesión");
        
        const lat = document.getElementById('offer-lat').value;
        const lng = document.getElementById('offer-lng').value;
        if(!lat || !lng) return alert("⚠️ Falta la ubicación. Usa el mapa.");

        const btn = document.getElementById('btn-offer-submit');
        btn.disabled = true; btn.innerText = 'Publicando...';

        const priceKwh = document.getElementById('offer-price-kwh').value;
        const priceParking = document.getElementById('offer-price-parking').value;

        const { error } = await _supabase.from('chargers').insert([{
            user_id: currentUser.id,
            title: document.getElementById('offer-title').value.trim(),
            city: document.getElementById('offer-city').value.trim(),
            address: document.getElementById('offer-address').value.trim(),
            charger_type: document.getElementById('offer-type').value,
            power: document.getElementById('offer-power').value,
            price_kwh: priceKwh === '' ? null : priceKwh,
            price_parking: priceParking === '' ? null : priceParking,
            parking_type: document.getElementById('offer-parking-type').value,
            schedule: document.getElementById('offer-schedule').value.trim(),
            link: document.getElementById('offer-link').value.trim() || null,
            lat: parseFloat(lat), 
            lng: parseFloat(lng)
        }]);

        btn.disabled = false; btn.innerText = 'PUBLICAR CARGADOR';

        if(error) alert(error.message);
        else { 
            alert("¡Cargador publicado!"); 
            closeModal('modal-offer'); 
            document.getElementById('form-offer').reset();
            document.getElementById('location-status').innerText = 'Coordenadas pendientes...';
            document.getElementById('offer-preview-map').style.display = 'none';
            loadChargers(); 
        }
    }

    // ================= UTILIDADES =================
    function loadMore() {
        itemsLimit += 10;
        applyFilter();
    }

    function filterChargers() {
        itemsLimit = 10;
        applyFilter();
    }

    function applyFilter() {
        const term = normalize(document.getElementById('city-search').value);
        const filtered = term === ''
            ? chargersData
            : chargersData.filter(c =>
                normalize(c.city).includes(term) ||
                normalize(c.title).includes(term) ||
                normalize(c.address).includes(term)
              );
        renderChargers(filtered);
    }
    
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // ==== PIN -> contraseña de Supabase ====
    // Sufijo fijo que se agrega al PIN para formar la "contraseña" guardada.
    // Ej: PIN 1997 -> contraseña 199799
    const PIN_SUFFIX = '99';
    function pinToPassword(pin) { return pin + PIN_SUFFIX; }

    // Auth Events
    document.getElementById('form-register').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('reg-name').value.trim();
        const phone = document.getElementById('reg-phone').value.trim();
        const email = document.getElementById('reg-email').value.trim();
        const pin = document.getElementById('reg-pin').value.trim();
        const pinConfirm = document.getElementById('reg-pin-confirm').value.trim();

        if(!/^\d{4}$/.test(pin)) return alert("El PIN debe tener exactamente 4 dígitos numéricos");
        if(pin !== pinConfirm) return alert("Los PIN no coinciden");

        const btn = document.getElementById('btn-register-submit');
        btn.disabled = true; btn.innerText = 'Creando...';

        const { data, error } = await _supabase.auth.signUp({
            email: email,
            password: pinToPassword(pin),
            options: { data: {
                full_name: name, phone: phone,
                consent_email: document.getElementById('reg-consent-email').checked,
                consent_whatsapp: document.getElementById('reg-consent-whatsapp').checked,
                terms_accepted: true
            } }
        });

        btn.disabled = false; btn.innerText = 'Registrarse';

        if(error) {
            alert(error.message);
        } else {
            document.getElementById('form-register').reset();
            closeModal('modal-register');
            openModal('modal-login');
        }
    });

    document.getElementById('form-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const pin = document.getElementById('login-pin').value.trim();
        if(!/^\d{4}$/.test(pin)) return alert("El PIN debe tener exactamente 4 dígitos numéricos");

        const btn = document.getElementById('btn-login-submit');
        btn.disabled = true; btn.innerText = 'Ingresando...';
        const { error } = await _supabase.auth.signInWithPassword({ email: email, password: pinToPassword(pin) });
        btn.disabled = false; btn.innerText = 'Iniciar Sesión';
        if(error) alert("Correo o PIN incorrecto"); else { document.getElementById('form-login').reset(); closeModal('modal-login'); checkSession(); }
    });

    document.getElementById('form-offer').addEventListener('submit', postCharger);
    async function logout() { await _supabase.auth.signOut(); window.location.reload(); }

    // ================= VISITAS (anónimas, sin IP) =================
    async function logVisit() {
        try {
            if (sessionStorage.getItem('visit-logged')) return; // una por sesión de navegador
            sessionStorage.setItem('visit-logged', '1');
        } catch(e) {}
        let vid = null;
        try {
            vid = localStorage.getItem('evcar-vid');
            if (!vid) { vid = crypto.randomUUID(); localStorage.setItem('evcar-vid', vid); }
        } catch(e) {}
        await _supabase.auth.getSession(); // para asociar la visita si hay sesión
        await _supabase.from('page_visits').insert([{
            path: location.pathname.slice(0, 200),
            referrer: (document.referrer || '').slice(0, 300) || null,
            visitor_id: vid,
            device: /Mobi|Android|iPhone/i.test(navigator.userAgent) ? 'mobile' : 'desktop'
        }]);
    }

    // ================= COMPLETAR PERFIL =================
    function openCompleteProfile(p) {
        document.getElementById('cp-name').value = p.full_name || currentUser.user_metadata?.full_name || currentUser.user_metadata?.name || '';
        document.getElementById('cp-email').value = currentUser.email || '';
        document.getElementById('cp-phone').value = p.phone || '';
        document.getElementById('cp-consent-email').checked = !!p.consent_email;
        document.getElementById('cp-consent-whatsapp').checked = !!p.consent_whatsapp;
        document.getElementById('cp-terms').checked = false;
        openModal('modal-complete');
    }

    document.getElementById('form-complete').addEventListener('submit', async (e) => {
        e.preventDefault();
        const phone = document.getElementById('cp-phone').value.trim();
        if (!/^\+?\d{9,15}$/.test(phone.replace(/[\s-]/g, ''))) return alert('Escribe un número celular válido');
        const now = new Date().toISOString();
        const payload = {
            full_name: document.getElementById('cp-name').value.trim(),
            phone: phone,
            consent_email: document.getElementById('cp-consent-email').checked,
            consent_whatsapp: document.getElementById('cp-consent-whatsapp').checked,
            consent_updated_at: now,
            terms_accepted_at: now
        };
        const btn = document.getElementById('btn-complete-submit');
        btn.disabled = true; btn.innerText = 'Guardando...';
        const { error } = await _supabase.from('profiles').update(payload).eq('id', currentUser.id);
        btn.disabled = false; btn.innerText = 'Guardar y continuar';
        if (error) return alert(error.message);
        currentProfile = { ...currentProfile, ...payload };
        document.getElementById('user-display-name').innerText = `Hola, ${payload.full_name}`;
        closeModal('modal-complete');
    });

    // ================= PERMISOS DE COMUNICACIÓN =================
    function openConsent() {
        document.getElementById('consent-email').checked = !!currentProfile?.consent_email;
        document.getElementById('consent-whatsapp').checked = !!currentProfile?.consent_whatsapp;
        document.getElementById('consent-phone').value = currentProfile?.phone || '';
        toggleConsentPhone();
        openModal('modal-consent');
    }

    function toggleConsentPhone() {
        const needsPhone = document.getElementById('consent-whatsapp').checked && !currentProfile?.phone;
        document.getElementById('consent-phone').classList.toggle('hidden', !needsPhone);
    }
    document.getElementById('consent-whatsapp').addEventListener('change', toggleConsentPhone);

    async function saveConsent(skip = false) {
        try { sessionStorage.setItem('consent-asked', '1'); } catch(e) {}
        if (!currentUser) return closeModal('modal-consent');
        const payload = {
            consent_email: skip ? false : document.getElementById('consent-email').checked,
            consent_whatsapp: skip ? false : document.getElementById('consent-whatsapp').checked,
            consent_updated_at: new Date().toISOString()
        };
        const phone = document.getElementById('consent-phone').value.trim();
        if (!skip && payload.consent_whatsapp && !currentProfile?.phone) {
            if (!/^\+?\d{9,15}$/.test(phone.replace(/[\s-]/g, ''))) return alert('Escribe un número de WhatsApp válido');
            payload.phone = phone;
        }
        const { error } = await _supabase.from('profiles').update(payload).eq('id', currentUser.id);
        if (error) return alert(error.message);
        currentProfile = { ...currentProfile, ...payload };
        closeModal('modal-consent');
        if (!skip) alert('¡Preferencias guardadas!');
    }

    // ================= LOGIN CON GOOGLE =================
    async function loginWithGoogle() {
        const { error } = await _supabase.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: window.location.origin + window.location.pathname }
        });
        if(error) alert(error.message);
    }

    // ================= ANUNCIOS =================
    function safeUrl(url) {
        return /^https?:\/\//i.test(url || '') ? url : '#';
    }

    async function loadAds() {
        const { data, error } = await _supabase.from('ads').select('*').eq('active', true).order('sort_order').order('created_at', { ascending: false });
        if(error || !data) return;

        const fixed = data.filter(a => a.kind === 'fixed');
        const box = document.getElementById('fixed-ads');
        if(fixed.length) {
            box.innerHTML = fixed.map(a => `
                <div class="bg-gradient-to-r from-green-50 to-white border border-green-200 rounded-2xl p-4 mb-3 flex flex-col sm:flex-row items-center gap-4 shadow-sm">
                    ${a.image_url ? `<img src="${escapeHtml(safeUrl(a.image_url))}" alt="${escapeHtml(a.title)}" class="w-full sm:w-32 h-24 object-cover rounded-lg" loading="lazy">` : ''}
                    <div class="flex-grow text-center sm:text-left">
                        <p class="font-bold text-slate-800">${escapeHtml(a.title)}</p>
                        ${a.body ? `<p class="text-sm text-slate-600">${escapeHtml(a.body)}</p>` : ''}
                    </div>
                    ${a.link_url ? `<a href="${escapeHtml(safeUrl(a.link_url))}" target="_blank" rel="noopener sponsored" class="bg-green-600 text-white px-5 py-2 rounded-lg font-bold hover:bg-green-700 transition shadow shrink-0 text-sm">${escapeHtml(a.button_text || 'Ver más')}</a>` : ''}
                </div>`).join('');
            box.classList.remove('hidden');
        }

        const popup = data.find(a => a.kind === 'popup');
        let dismissed = false;
        try { dismissed = sessionStorage.getItem('promo-closed') === String(popup?.id); } catch(e) {}
        if(popup && !dismissed) {
            document.getElementById('promo-title').innerText = popup.title || '';
            document.getElementById('promo-body').innerText = popup.body || '';
            document.getElementById('promo-button').innerText = popup.button_text || 'Escribir por WhatsApp';
            document.getElementById('promo-link').href = safeUrl(popup.link_url);
            const img = document.getElementById('promo-image');
            if(popup.image_url) { img.src = safeUrl(popup.image_url); img.alt = popup.title || ''; img.classList.remove('hidden'); }
            document.getElementById('promo-popup').dataset.adId = popup.id;
            setTimeout(() => document.getElementById('promo-popup').classList.remove('hidden'), 5000);
        }
    }

    function closePromo() {
        const el = document.getElementById('promo-popup');
        el.classList.add('hidden');
        try { sessionStorage.setItem('promo-closed', el.dataset.adId || ''); } catch(e) {}
    }
</script>
