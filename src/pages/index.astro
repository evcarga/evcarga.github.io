    <meta name="twitter:description" content="Encuentra puntos de carga para tu auto eléctrico e instala tu cargador desde $20 USD.">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://evcarga.github.io/#website",
          "url": "https://evcarga.github.io/",
          "name": "EvCarga Ecuador",
          "alternateName": ["EvCarga", "EvCar", "evcarga.github.io"],
          "description": "Red colaborativa de cargadores para carros eléctricos en Ecuador",
          "publisher": { "@type": "Organization", "name": "EvCarga Ecuador", "alternateName": ["EvCarga", "EvCar"], "url": "https://evcarga.github.io/", "logo": "https://evcarga.github.io/favicon-512.png" },
          "inLanguage": "es-EC"
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://evcarga.github.io/#negocio",
          "name": "EvCarga Ecuador - Instalación de cargadores para carros eléctricos",
          "alternateName": "EvCarga",
          "url": "https://evcarga.github.io/",
          "image": "https://evcarga.github.io/favicon-512.png",
          "telephone": "+593980407829",
          "priceRange": "Desde $20 USD",
          "areaServed": { "@type": "Country", "name": "Ecuador" },
          "address": { "@type": "PostalAddress", "addressCountry": "EC" },
          "makesOffer": {
            "@type": "Offer",
            "priceCurrency": "USD",
            "price": "20",
            "itemOffered": {
              "@type": "Service",
              "name": "Instalación de cargadores para carros eléctricos",
              "serviceType": "Instalación de cargador para auto eléctrico (Tipo 1, Tipo 2, wallbox, tomacorriente 220V)"
            }
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            { "@type": "Question", "name": "¿Dónde encuentro cargadores para carros eléctricos en Ecuador?",
              "acceptedAnswer": { "@type": "Answer", "text": "En EvCar puedes ver en un mapa los cargadores y electrolineras para autos eléctricos en Quito, Guayaquil, Cuenca, Manta, Machala, Santo Domingo y más ciudades, con potencia, tipo de conector, horario y precio." } },
            { "@type": "Question", "name": "¿Cuánto cuesta la instalación de un cargador para carro eléctrico?",
              "acceptedAnswer": { "@type": "Answer", "text": "La instalación de cargadores para carros eléctricos con EvCar es desde $20 USD, según el tipo de cargador y la instalación eléctrica. Cotiza por WhatsApp al +593 98 040 7829." } },
            { "@type": "Question", "name": "¿Qué tipos de conectores de carga hay en Ecuador?",
              "acceptedAnswer": { "@type": "Answer", "text": "Los más comunes son Tipo 2, Tipo 1, CCS2, CHAdeMO, GB/T y tomacorrientes de 220V 32A. En EvCar cada punto de carga indica su conector y potencia (de 3.7 kW hasta 90 kW)." } },
            { "@type": "Question", "name": "¿Puedo publicar mi cargador en EvCar?",
              "acceptedAnswer": { "@type": "Answer", "text": "Sí. Crea tu cuenta gratis (también con Google) y publica tu punto de carga con ubicación, potencia, precio y horario." } }
          ]
        }
      ]
    }
    </script>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Plugin para botón de ubicación -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.locatecontrol@0.79.0/dist/L.Control.Locate.min.css" />
    <script is:inline src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style is:global>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        
        /* Mapas */
        #main-map { min-height: 300px; width: 100%; border-radius: 0.75rem; z-index: 1; }
        #picker-map { height: 260px; width: 100%; border-radius: 0.5rem; }
        #offer-preview-map { height: 140px; width: 100%; border-radius: 0.5rem; margin-top: 0.5rem; display: none; }
        #detail-map { height: 200px; width: 100%; border-radius: 0.5rem; margin-top: 1rem; }

        /* Modales */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); z-index: 50; justify-content: center; align-items: center; backdrop-filter: blur(4px); }
        .modal.active { display: flex; animation: fadeIn 0.2s ease-out; }
        
        /* Animaciones */
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
        .card-hover:hover { transform: translateY(-3px); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1); }
        
        /* Leaflet Font Fix */
        .leaflet-container { font-family: 'Inter', sans-serif; background: #f2efe9; }
        .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0,0,0,.15); }
        .leaflet-popup-content { margin: 8px; }
        .leaflet-popup-content p { margin: 0; } /* Leaflet agrega márgenes grandes a los párrafos */ /* MARGEN REDUCIDO PARA OCUPAR MENOS VOLUMEN */
        .leaflet-popup-tip { box-shadow: none; }
        .leaflet-control-zoom a { border-radius: 8px !important; }
        /* Ajuste sutil para CartoDB */

        
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        /* ESTILOS PARA MARCADORES PERSONALIZADOS (Pines Modernos) */
        .marker-pin {
            width: 34px;
            height: 34px;
            border-radius: 50% 50% 50% 0;
            background: #16a34a; /* Green default */
            position: absolute;
            transform: rotate(-45deg);
            left: 50%;
            top: 50%;
            margin: -20px 0 0 -17px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
            border: 2px solid #ffffff;
        }
        .marker-pin::after {
            content: '';
            width: 14px;
            height: 14px;
            margin: 8px 0 0 8px;
            background: #fff;
            position: absolute;
            border-radius: 50%;
            box-shadow: inset 0 0 4px rgba(0,0,0,0.2);
        }
        .marker-pin.fast { background: #2563eb; }
        .marker-pin.occupied {
            background: #dc2626; /* Red */
        }
        .leaflet-div-icon {
            background: transparent;
            border: none;
        }

        /* Marcador de ubicación del usuario: pin rojo con coche */
        .user-location-pin {
            width: 36px;
            height: 36px;
            border-radius: 50% 50% 50% 0;
            background: #ef4444; /* Rojo */
            position: absolute;
            transform: rotate(-45deg);
            left: 50%;
            top: 50%;
            margin: -22px 0 0 -18px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
            border: 2px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .user-location-pin::after {
            content: '';
            width: 16px;
            height: 16px;
            background: white;
            position: absolute;
            border-radius: 50%;
            box-shadow: inset 0 0 4px rgba(0,0,0,0.2);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(45deg);
        }
        .user-location-pin svg {
            transform: rotate(45deg);
            width: 20px;
            height: 20px;
            color: #ef4444;
            z-index: 1;
        }
    </style>
</head>
<body class="text-slate-700">

    <nav class="bg-white/80 backdrop-blur-md shadow-sm p-4 sticky top-0 z-40 border-b border-slate-100">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-br from-green-400 to-green-600 p-2 rounded-lg shadow-lg text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                </div>
                <div>
                    <a href="#" class="text-2xl font-bold text-slate-800 tracking-tight" onclick="window.location.reload()">EvCar</a>
                    <span id="user-display-name" class="block text-xs font-medium text-green-600 hidden"></span>
                </div>
            </div>
            
            <div id="nav-buttons" class="flex items-center gap-3 text-sm font-medium"></div>
        </div>
    </nav>

    <header class="bg-slate-900 text-white text-center py-10 px-4 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-slate-900/80"></div>
        
        <div class="relative z-10 max-w-3xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-3 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-green-300 to-white">Carga sin límites</h1>
            <p class="text-lg md:text-xl text-slate-300 mb-6 font-light">EvCarga Ecuador: cargadores para carros eléctricos, red colaborativa de puntos de carga y electrolineras.</p>
            
            <div class="bg-white/10 backdrop-blur-sm p-2 rounded-2xl border border-white/10 shadow-2xl flex w-full max-w-lg mx-auto mb-6 transform transition hover:scale-[1.01]">
                <input type="text" id="city-search" placeholder="Escribir ciudad o punto de referencia" class="flex-grow p-3 bg-transparent text-white outline-none placeholder-slate-400 min-w-0" oninput="filterChargers()">
                <button onclick="filterChargers()" class="bg-green-500 hover:bg-green-400 text-slate-900 px-4 sm:px-6 py-2 rounded-xl font-bold transition shadow-lg shrink-0 ml-2">
                    Buscar
                </button>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
                <button onclick="openMainMap()" class="bg-white text-slate-900 px-6 py-2.5 rounded-xl font-bold shadow-lg hover:bg-slate-50 transition flex items-center gap-2 w-full sm:w-auto justify-center ring-1 ring-slate-200">
                    🗺️ Abrir Mapa
                </button>
                <button id="btn-offer-hero" onclick="openModal('modal-offer')" class="hidden bg-yellow-400 text-yellow-900 px-6 py-2.5 rounded-xl font-bold shadow-lg hover:bg-yellow-300 transition flex items-center gap-2 w-full sm:w-auto justify-center border border-yellow-500/30">
                    ⚡ Ofrecer Cargador
                </button>
            </div>
        </div>
    </header>

    <!-- Anuncios fijos (se muestran solo si hay anuncios activos) -->
    <section id="fixed-ads" class="container mx-auto px-4 mt-10 mb-2 hidden" aria-label="Anuncios"></section>

    <div class="container mx-auto -mt-6 px-4 mb-8 relative z-20">
        <div class="bg-white rounded-2xl p-6 shadow-xl border border-green-500">
            <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-4">
                <h3 class="text-xl font-bold text-slate-800">Puntos Disponibles</h3>
                <span class="text-xs font-bold text-green-700 bg-green-50 px-3 py-1 rounded-full border border-green-100" id="count-chargers">Cargando...</span>
            </div>
            
            <div id="chargers-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="bg-slate-50 h-48 rounded-xl animate-pulse"></div>
                <div class="bg-slate-50 h-48 rounded-xl animate-pulse"></div>
                <div class="bg-slate-50 h-48 rounded-xl animate-pulse"></div>
            </div>

            <div id="load-more-container" class="mt-8 text-center hidden">
                <button onclick="loadMore()" class="bg-white text-slate-600 border border-slate-300 px-6 py-3 rounded-full font-bold hover:bg-slate-50 hover:text-green-600 transition shadow-sm flex items-center gap-2 mx-auto">
                    ⬇️ Ver más cargadores
                </button>
            </div>
        </div>
    </div>

    <!-- Modales de detalle y registro se mantienen igual -->
    <div id="modal-detail" class="modal" onclick="if(event.target===this) closeModal('modal-detail')">
        <div class="bg-white rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh] m-4">
            <div class="bg-slate-900 p-4 flex justify-between items-center text-white">
                <h2 class="text-lg font-bold flex items-center gap-2">
                    <span class="bg-white/20 p-1 rounded">⚡</span>
                    <span id="detail-title">Detalle</span>
                </h2>
                <button onclick="closeModal('modal-detail')" class="text-slate-400 hover:text-white transition">✕</button>
            </div>
            
            <div class="p-6 overflow-y-auto custom-scroll text-slate-600 space-y-6">
                <div id="detail-status-banner" class="text-center p-3 rounded-lg font-bold text-sm shadow-sm"></div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs text-slate-400 uppercase font-bold tracking-wider mb-1">Ubicación</p>
                            <p class="text-xl font-bold text-slate-800" id="detail-city"></p>
                            <p class="text-sm text-slate-500" id="detail-address"></p>
                        </div>

                        <div>
                            <p class="text-xs text-slate-400 uppercase font-bold tracking-wider mb-2">Tarifas</p>
                            <div class="flex gap-3">
                                <div class="bg-blue-50 px-4 py-2 rounded-lg border border-blue-100">
                                    <span class="block text-[10px] uppercase text-blue-500 font-bold">Energía</span>
                                    <span class="font-bold text-blue-700 text-lg" id="detail-price-kwh"></span>
                                </div>
                                <div class="bg-orange-50 px-4 py-2 rounded-lg border border-orange-100">
                                    <span class="block text-[10px] uppercase text-orange-500 font-bold">Parqueo</span>
                                    <span class="font-bold text-orange-700 text-lg" id="detail-price-parking"></span>
                                </div>
                            </div>
                        </div>

                        <ul class="text-sm space-y-2 bg-slate-50 p-3 rounded-lg border border-slate-100">
                            <li class="flex justify-between"><span>Tipo:</span> <strong class="text-slate-800 text-right" id="detail-type"></strong></li>
                            <li class="flex justify-between"><span>Potencia:</span> <strong class="text-slate-800" id="detail-power"></strong></li>
                            <li class="flex justify-between"><span>Lugar:</span> <strong class="text-slate-800" id="detail-parking-type"></strong></li>
                        </ul>
                    </div>
                    
                    <div class="flex flex-col h-full">
                        <p class="text-xs text-slate-400 uppercase font-bold tracking-wider mb-1">Horario</p>
                        <p class="text-sm font-medium mb-4 text-slate-800" id="detail-schedule"></p>
                        
                        <p class="text-xs text-slate-400 uppercase font-bold tracking-wider mb-1">Ubicación Exacta</p>
                        <div id="detail-map" class="flex-grow border border-slate-200 shadow-inner rounded-lg"></div>
                        
                        <div id="detail-action-buttons" class="mt-4 space-y-2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de mapa principal -->
    <div id="modal-main-map" class="modal">
        <div class="bg-white sm:p-2 sm:rounded-2xl w-full h-full sm:w-[97vw] sm:h-[94vh] shadow-2xl flex flex-col relative overflow-hidden">
            <div class="absolute top-2 left-2 right-14 sm:top-4 sm:left-4 sm:right-auto sm:w-96 z-[400] bg-white/95 backdrop-blur p-2 rounded-xl shadow-md border border-slate-100">
                <form onsubmit="event.preventDefault(); searchMap()" class="flex gap-1.5">
                    <input type="search" id="map-search" list="map-search-options" placeholder="Buscar provincia o ciudad" class="flex-grow min-w-0 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg text-base sm:text-sm outline-none focus:ring-2 focus:ring-green-500">
                    <button type="submit" class="bg-green-600 text-white px-3 rounded-lg text-sm font-bold hover:bg-green-700 shrink-0">Ir</button>
                </form>
                <datalist id="map-search-options"></datalist>
                <div class="flex gap-3 mt-1.5 text-[10px] text-slate-500 px-1">
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-green-600"></span>Disponible</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>Carga rápida (50+ kW)</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>Ocupado</span>
                </div>
            </div>
            <button onclick="closeModal('modal-main-map')" class="absolute top-2 right-2 sm:top-4 sm:right-4 z-[400] bg-white text-slate-500 hover:text-red-500 font-bold p-2 rounded-full shadow-md transition w-10 h-10 flex items-center justify-center" aria-label="Cerrar mapa">✕</button>
            <div id="main-map" class="flex-grow w-full h-full sm:rounded-xl"></div>
        </div>
    </div>

    <div id="modal-register" class="modal">
        <div class="bg-white p-5 sm:p-7 rounded-2xl w-full max-w-sm mx-3 shadow-2xl border-t-4 border-green-500 max-h-[94vh] overflow-y-auto">
            <h2 class="text-xl font-bold mb-3 text-slate-800">Crear Cuenta</h2>
            <form id="form-register" class="space-y-2.5">
                <input type="text" id="reg-name" placeholder="Primer Nombre" class="w-full bg-slate-50 border border-slate-200 px-3 py-2 text-base rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
                <input type="tel" id="reg-phone" placeholder="Número Celular" class="w-full bg-slate-50 border border-slate-200 px-3 py-2 text-base rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
                <input type="email" id="reg-email" placeholder="Correo Electrónico" class="w-full bg-slate-50 border border-slate-200 px-3 py-2 text-base rounded-lg focus:ring-2 focus:ring-green-500 outline-none" required>
                <div class="grid grid-cols-2 gap-2">
                    <input type="password" id="reg-pin" placeholder="PIN (4 dígitos)" class="w-full bg-slate-50 border border-slate-200 px-3 py-2 text-base rounded-lg focus:ring-2 focus:ring-green-500 outline-none text-center tracking-[0.4em] placeholder:tracking-normal placeholder:text-sm" required inputmode="numeric" pattern="\d{4}" maxlength="4" minlength="4">
                    <input type="password" id="reg-pin-confirm" placeholder="Confirmar PIN" class="w-full bg-slate-50 border border-slate-200 px-3 py-2 text-base rounded-lg focus:ring-2 focus:ring-green-500 outline-none text-center tracking-[0.4em] placeholder:tracking-normal placeholder:text-sm" required inputmode="numeric" pattern="\d{4}" maxlength="4" minlength="4">
                </div>
                <div class="bg-green-50 border border-green-100 rounded-lg px-3 py-2 text-xs text-slate-600">
                    <p class="font-semibold text-slate-700 mb-1">Recibir novedades (opcional) por:</p>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-1.5"><input type="checkbox" id="reg-consent-email" class="w-4 h-4"> Correo</label>
                        <label class="flex items-center gap-1.5"><input type="checkbox" id="reg-consent-whatsapp" class="w-4 h-4"> WhatsApp</label>
                    </div>
                </div>
                <label class="flex items-start gap-2 text-[11px] text-slate-500">
                    <input type="checkbox" required class="mt-0.5 w-4 h-4 shrink-0">
                    <span class="leading-snug">Acepto la <a href="privacidad.html" target="_blank" class="text-green-700 underline">Política de Privacidad y Términos</a>, incluido mostrar mi teléfono a usuarios que necesiten cargadores.</span>
                </label>
                <button type="submit" id="btn-register-submit" class="w-full bg-green-600 text-white py-2.5 rounded-lg font-bold hover:bg-green-700 transition shadow-lg">Registrarse</button>
            </form>
