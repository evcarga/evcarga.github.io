    // Barras de una sola serie (visitas/día), con tooltip al pasar el mouse
    function renderVisitsChart(rows) {
        const box = document.getElementById('visits-chart');
        const W = Math.max(box.clientWidth, 300), H = 200, padL = 32, padB = 22, padT = 8;
        const max = Math.max(1, ...rows.map(r => r.visits));
        const step = Math.pow(10, Math.floor(Math.log10(max)));
        const top = Math.ceil(max / step) * step;
        const n = rows.length || 1, slot = (W - padL) / n, bw = Math.max(2, slot - 2);
        const y = v => padT + (H - padT - padB) * (1 - v / top);
        const fmtDay = d => new Date(d + 'T00:00:00').toLocaleDateString([], { day: '2-digit', month: 'short' });
        const labelEvery = Math.ceil(n / 7);
        let svg = `<svg width="${W}" height="${H}" role="img" aria-label="Visitas por día">`;
        [0, 0.5, 1].forEach(f => {
            const v = Math.round(top * f), yy = y(v);
            svg += `<line x1="${padL}" x2="${W}" y1="${yy}" y2="${yy}" stroke="#e2e8f0" stroke-width="1"/>`;
            svg += `<text x="${padL - 6}" y="${yy + 4}" text-anchor="end" font-size="10" fill="#94a3b8">${v}</text>`;
        });
        rows.forEach((r, i) => {
            const x = padL + i * slot + 1, yy = y(r.visits), h = Math.max(0, y(0) - yy);
            if (h > 0) svg += `<path d="M${x},${y(0)} V${yy + Math.min(4, h)} q0,-4 4,-4 h${Math.max(0, bw - 8)} q4,0 4,4 V${y(0)} Z" fill="#16a34a"/>`;
            svg += `<rect x="${x - 1}" y="${padT}" width="${slot}" height="${H - padT - padB}" fill="transparent" data-i="${i}" class="vbar"/>`;
            if (i % labelEvery === 0) svg += `<text x="${x + bw / 2}" y="${H - 6}" text-anchor="middle" font-size="10" fill="#94a3b8">${fmtDay(r.day)}</text>`;
        });
        svg += '</svg><div id="visits-tip" class="hidden absolute pointer-events-none bg-slate-900 text-white text-xs rounded-lg px-3 py-2 shadow-lg"></div>';
        box.innerHTML = svg;
        const tip = document.getElementById('visits-tip');
        box.querySelectorAll('.vbar').forEach(el => {
            el.addEventListener('mouseenter', () => {
                const r = rows[el.dataset.i];
                tip.innerHTML = `<b>${fmtDay(r.day)}</b><br>${r.visits} visitas · ${r.unique} únicos`;
                tip.classList.remove('hidden');
                const x = parseFloat(el.getAttribute('x'));
                tip.style.left = Math.min(x, W - 140) + 'px'; tip.style.top = '0px';
                el.setAttribute('fill', 'rgba(22,163,74,0.08)');
            });
            el.addEventListener('mouseleave', () => { tip.classList.add('hidden'); el.setAttribute('fill', 'transparent'); });
        });
    }

