<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/favicon-48.png?v=2" type="image/png" sizes="48x48">
    <link rel="icon" href="/favicon-96.png?v=2" type="image/png" sizes="96x96">
    <link rel="icon" href="/favicon-192.png?v=2" type="image/png" sizes="192x192">
    <link rel="shortcut icon" href="/favicon.ico?v=2">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <title>EvCar - Administración</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://unpkg.com/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .modal { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 50; justify-content: center; align-items: center; backdrop-filter: blur(4px); }
        .modal.active { display: flex; }
        .tab-btn.active { background: #16a34a; color: #fff; }
        .field { width: 100%; border: 1px solid #e2e8f0; background: #f8fafc; padding: .6rem; border-radius: .5rem; font-size: .875rem; }
        .lbl { display: block; font-size: .7rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: .2rem; }
    </style>
</head>
<body class="text-slate-700">
    <nav class="bg-white shadow-sm p-4 sticky top-0 z-40 border-b border-slate-100">
        <div class="container mx-auto flex justify-between items-center gap-3">
            <a href="index.html" class="text-2xl font-bold text-slate-800">EvCar <span class="text-sm font-medium text-green-600">Admin</span></a>
            <div class="flex items-center gap-3 text-sm">
                <span id="admin-name" class="text-slate-500 hidden sm:inline"></span>
                <button id="btn-logout" onclick="logout()" class="hidden bg-slate-100 px-4 py-2 rounded-lg font-bold hover:bg-slate-200">Salir</button>
            </div>
        </div>
    </nav>

    <!-- Acceso -->
    <section id="login-view" class="hidden max-w-sm mx-auto mt-16 bg-white p-8 rounded-2xl shadow-xl border-t-4 border-green-500">
        <h1 class="text-2xl font-bold mb-2 text-slate-800">Panel de administración</h1>
        <p id="login-msg" class="text-sm text-slate-500 mb-6">Ingresa con una cuenta de administrador.</p>
        <form id="form-login" class="space-y-4">
            <input type="email" id="login-email" placeholder="Correo electrónico" class="field" required>
            <input type="password" id="login-pin" placeholder="PIN o contraseña" autocomplete="current-password" class="field" required>
            <button type="submit" class="w-full bg-slate-900 text-white py-3 rounded-lg font-bold hover:bg-black">Iniciar sesión</button>
        </form>
        <button onclick="loginWithGoogle()" class="mt-3 w-full bg-white border border-slate-300 py-3 rounded-lg font-bold hover:bg-slate-50">Continuar con Google</button>
    </section>

    <!-- Panel -->
    <main id="admin-view" class="hidden container mx-auto px-4 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
            <div class="bg-white rounded-xl p-4 border border-slate-100 shadow-sm"><p class="lbl">Cargadores</p><p id="stat-chargers" class="text-2xl font-bold text-slate-800">–</p></div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 shadow-sm"><p class="lbl">Ocupados / No disp.</p><p id="stat-occupied" class="text-2xl font-bold text-red-600">–</p></div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 shadow-sm"><p class="lbl">Usuarios</p><p id="stat-users" class="text-2xl font-bold text-slate-800">–</p></div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 shadow-sm"><p class="lbl">Anuncios activos</p><p id="stat-ads" class="text-2xl font-bold text-green-600">–</p></div>
        </div>

        <div class="flex gap-2 mb-4 flex-wrap">
            <button class="tab-btn active px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="chargers">⚡ Cargadores</button>
            <button class="tab-btn px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="users">👥 Usuarios</button>
            <button class="tab-btn px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="ads">📢 Anuncios</button>
            <button class="tab-btn px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="visits">📈 Visitas</button>
            <button class="tab-btn px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="reports">⚠️ Reportes <span id="badge-reports" class="hidden ml-1 bg-red-500 text-white text-[10px] px-1.5 py-0.5 rounded-full"></span></button>
            <button class="tab-btn px-4 py-2 rounded-lg font-bold bg-white border border-slate-200" data-tab="market">🛒 Marketplace <span id="badge-market" class="hidden ml-1 bg-yellow-500 text-white text-[10px] px-1.5 py-0.5 rounded-full"></span></button>
        </div>

        <!-- Cargadores -->
        <section id="tab-chargers" class="tab bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex flex-col sm:flex-row gap-2 mb-4">
                <input id="charger-search" oninput="renderChargers()" placeholder="Buscar por título, ciudad, dirección o dueño" class="field flex-grow">
                <select id="charger-status-filter" onchange="renderChargers()" class="field sm:w-48">
                    <option value="">Todos los estados</option><option value="DISPONIBLE">Disponibles</option><option value="OCUPADO">Ocupados</option><option value="NO DISPONIBLE">No disponibles</option>
                </select>
                <button onclick="openChargerForm()" class="bg-yellow-400 text-yellow-900 px-4 py-2 rounded-lg font-bold hover:bg-yellow-300 shrink-0">+ Nuevo cargador</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-xs uppercase text-slate-400 border-b"><tr>
                        <th class="p-2">ID</th><th class="p-2">Título</th><th class="p-2">Ciudad</th><th class="p-2">Potencia</th><th class="p-2">Conector</th><th class="p-2">Estado</th><th class="p-2">Dueño</th><th class="p-2"></th>
                    </tr></thead>
                    <tbody id="chargers-body"></tbody>
                </table>
            </div>
        </section>

        <!-- Usuarios -->
        <section id="tab-users" class="tab hidden bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex flex-col sm:flex-row gap-2 mb-4">
                <input id="user-search" oninput="renderUsers()" placeholder="Buscar por nombre, correo o teléfono" class="field flex-grow">
                <button onclick="exportConsented('email')" class="bg-white border border-slate-300 px-3 py-2 rounded-lg text-sm font-bold hover:bg-slate-50 shrink-0">⬇️ Correos con permiso</button>
                <button onclick="exportConsented('whatsapp')" class="bg-white border border-slate-300 px-3 py-2 rounded-lg text-sm font-bold hover:bg-slate-50 shrink-0">⬇️ WhatsApp con permiso</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="text-left text-xs uppercase text-slate-400 border-b"><tr>
                        <th class="p-2">Nombre</th><th class="p-2">Correo</th><th class="p-2">Teléfono</th><th class="p-2">Acceso</th><th class="p-2">Cargadores</th><th class="p-2">Registro</th><th class="p-2">Último ingreso</th><th class="p-2">Acepta avisos</th><th class="p-2">Rol</th>
                    </tr></thead>
                    <tbody id="users-body"></tbody>
                </table>
            </div>
        </section>

        <!-- Anuncios -->
        <section id="tab-ads" class="tab hidden bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex justify-between items-center mb-4 gap-2">
                <p class="text-sm text-slate-500">El anuncio <b>flotante</b> aparece a los 5 s de entrar. Los <b>fijos</b> se muestran bajo la cabecera. Si no hay activos, no se muestra nada.</p>
                <button onclick="openAdForm()" class="bg-green-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-green-700 shrink-0">+ Nuevo anuncio</button>
            </div>
            <div id="ads-list" class="grid md:grid-cols-2 gap-4"></div>
        </section>

        <!-- Visitas -->
        <section id="tab-visits" class="tab hidden bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex justify-between items-center mb-4 gap-2">
                <p class="text-sm text-slate-500">Visitas anónimas a la web (una por sesión de navegador, sin IP).</p>
                <select id="visits-range" onchange="loadVisits()" class="border border-slate-200 rounded-lg p-2 text-sm">
                    <option value="7">Últimos 7 días</option><option value="30" selected>Últimos 30 días</option><option value="90">Últimos 90 días</option>
                </select>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-5">
                <div class="bg-slate-50 rounded-xl p-3"><p class="lbl">Hoy</p><p id="v-today" class="text-2xl font-bold text-slate-800">–</p></div>
                <div class="bg-slate-50 rounded-xl p-3"><p class="lbl">Visitas</p><p id="v-total" class="text-2xl font-bold text-slate-800">–</p></div>
                <div class="bg-slate-50 rounded-xl p-3"><p class="lbl">Visitantes únicos</p><p id="v-unique" class="text-2xl font-bold text-slate-800">–</p></div>
                <div class="bg-slate-50 rounded-xl p-3"><p class="lbl">Desde celular</p><p id="v-mobile" class="text-2xl font-bold text-slate-800">–</p></div>
                <div class="bg-slate-50 rounded-xl p-3"><p class="lbl">Con sesión</p><p id="v-logged" class="text-2xl font-bold text-slate-800">–</p></div>
            </div>
            <p class="text-sm font-bold text-slate-700 mb-2">Visitas por día</p>
            <div id="visits-chart" class="relative w-full mb-6"></div>
            <p class="text-sm font-bold text-slate-700 mb-2">De dónde llegan</p>
            <table class="w-full text-sm max-w-md">
                <thead class="text-left text-xs uppercase text-slate-400 border-b"><tr><th class="p-2">Origen</th><th class="p-2 text-right">Visitas</th></tr></thead>
                <tbody id="referrers-body"></tbody>
            </table>
        </section>

        <!-- Reportes de novedades -->
        <section id="tab-reports" class="tab hidden bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex justify-between items-center gap-2 mb-4">
                <p class="text-sm text-slate-500">Novedades que reportan los usuarios desde la lista y el mapa.</p>
                <select id="reports-filter" onchange="renderReports()" class="field w-40"><option value="nuevo">Nuevos</option><option value="revisado">Revisados</option><option value="">Todos</option></select>
            </div>
            <div id="reports-list" class="space-y-2"></div>
        </section>

        <!-- Marketplace -->
        <section id="tab-market" class="tab hidden bg-white rounded-2xl p-4 shadow-sm border border-slate-100">
            <div class="flex justify-between items-center gap-2 mb-4">
                <p class="text-sm text-slate-500">Toda publicación debe aprobarse para aparecer en <a href="/entorno.html" target="_blank" class="text-green-700 underline">Comunidad EV</a>.</p>
                <select id="market-filter" onchange="renderMarketAdmin()" class="field w-40"><option value="pendiente">Pendientes</option><option value="aprobado">Aprobadas</option><option value="rechazado">Rechazadas</option><option value="">Todas</option></select>
            </div>
            <div id="market-admin-list" class="grid md:grid-cols-2 gap-3"></div>
        </section>
    </main>

    <!-- Editar publicación del marketplace -->
    <div id="modal-listing" class="modal">
        <form id="form-listing" class="bg-white p-6 rounded-2xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto m-4 space-y-3">
            <h2 class="text-xl font-bold text-slate-800">Editar publicación</h2>
            <input type="hidden" id="l-id">
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Tipo</label><select id="l-kind" class="field"><option value="producto">Producto</option><option value="servicio">Servicio</option></select></div>
                <div><label class="lbl">Categoría</label><input id="l-cat" class="field" maxlength="40" required></div>
            </div>
            <div><label class="lbl">Título</label><input id="l-title" class="field" maxlength="120" required></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Precio (vacío = a convenir)</label><input id="l-price" type="number" step="0.01" min="0" class="field"></div>
                <div><label class="lbl">Ciudad</label><input id="l-city" class="field" maxlength="80"></div>
            </div>
            <div><label class="lbl">Descripción</label><textarea id="l-desc" rows="4" maxlength="3000" class="field"></textarea></div>
            <div class="grid grid-cols-2 gap-3">
                <label class="flex items-center gap-2 text-sm font-bold"><input id="l-company" type="checkbox" class="w-4 h-4"> Empresa</label>
                <input id="l-company-name" class="field" maxlength="80" placeholder="Nombre de la empresa">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Estado</label><select id="l-status" class="field"><option value="pendiente">Pendiente</option><option value="aprobado">Aprobado</option><option value="rechazado">Rechazado</option></select></div>
                <div><label class="lbl">Nota para el usuario</label><input id="l-note" class="field" maxlength="300"></div>
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModal('modal-listing')" class="px-4 py-2 text-slate-500 hover:bg-slate-100 rounded-lg">Cancelar</button>
                <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700">Guardar</button>
            </div>
        </form>
    </div>

    <!-- Formulario cargador -->
    <div id="modal-charger" class="modal">
        <form id="form-charger" class="bg-white p-6 rounded-2xl w-full max-w-2xl shadow-2xl max-h-[90vh] overflow-y-auto m-4 space-y-3">
            <h2 id="charger-form-title" class="text-xl font-bold text-slate-800">Cargador</h2>
            <input type="hidden" id="c-id">
            <div><label class="lbl">Título</label><input id="c-title" class="field" required maxlength="120"></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Ciudad</label><input id="c-city" class="field" required maxlength="80"></div>
                <div><label class="lbl">Provincia</label><input id="c-provincia" class="field" maxlength="80"></div>
            </div>
            <div><label class="lbl">Dirección</label><input id="c-address" class="field" maxlength="160"></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Tipo conector</label><input id="c-type" class="field" list="types-list" maxlength="120"></div>
                <div><label class="lbl">Potencia</label><input id="c-power" class="field" list="power-list" maxlength="60"></div>
            </div>
            <datalist id="types-list"><option>Tipo 1</option><option>Tipo 2</option><option>Pared Tipo 2</option><option>CCS2</option><option>Chademo</option><option>GBT</option><option>Toma 220v</option><option>Toma 110v</option><option>Electrolinera</option></datalist>
            <datalist id="power-list"><option>3.7 KW</option><option>7 KW</option><option>15 KW</option><option>50 KW</option><option>60 KW</option><option>90 KW</option></datalist>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Precio / kWh</label><input id="c-price-kwh" class="field"></div>
                <div><label class="lbl">Precio / h parqueo</label><input id="c-price-parking" class="field"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Tipo parqueadero</label><input id="c-parking-type" class="field" maxlength="60"></div>
                <div><label class="lbl">Horario</label><input id="c-schedule" class="field" maxlength="120"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Latitud</label><input id="c-lat" type="number" step="any" class="field" required></div>
                <div><label class="lbl">Longitud</label><input id="c-lng" type="number" step="any" class="field" required></div>
            </div>
            <div><label class="lbl">Link Google Maps</label><input id="c-link" type="url" class="field"></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Estado</label><select id="c-status" class="field"><option>DISPONIBLE</option><option>OCUPADO</option><option>NO DISPONIBLE</option></select></div>
                <div><label class="lbl">Teléfono de contacto</label><input id="c-contact-phone" class="field" maxlength="30"></div>
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModal('modal-charger')" class="px-4 py-2 text-slate-500 hover:bg-slate-100 rounded-lg">Cancelar</button>
                <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700">Guardar</button>
            </div>
        </form>
    </div>

    <!-- Formulario anuncio -->
    <div id="modal-ad" class="modal">
        <form id="form-ad" class="bg-white p-6 rounded-2xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto m-4 space-y-3">
            <h2 class="text-xl font-bold text-slate-800">Anuncio</h2>
            <input type="hidden" id="a-id">
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Tipo</label><select id="a-kind" class="field"><option value="fixed">Fijo (banner)</option><option value="popup">Flotante (a los 5 s)</option></select></div>
                <div><label class="lbl">Orden</label><input id="a-order" type="number" value="0" class="field"></div>
            </div>
            <div><label class="lbl">Título</label><input id="a-title" class="field" required maxlength="140"></div>
            <div><label class="lbl">Texto</label><textarea id="a-body" rows="3" class="field" maxlength="500"></textarea></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="lbl">Texto del botón</label><input id="a-button" class="field" maxlength="40"></div>
                <div><label class="lbl">Enlace (https://)</label><input id="a-link" type="url" class="field"></div>
            </div>
            <div><label class="lbl">Imagen (URL https, opcional)</label><input id="a-image" type="url" class="field"></div>
            <label class="flex items-center gap-2 text-sm font-bold"><input id="a-active" type="checkbox" class="w-4 h-4"> Activo</label>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeModal('modal-ad')" class="px-4 py-2 text-slate-500 hover:bg-slate-100 rounded-lg">Cancelar</button>
                <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700">Guardar</button>
            </div>
        </form>
    </div>

<script is:inline>
    // ================= CONFIGURACIÓN =================
    const SUPABASE_URL = 'https://yjnlfewsgksdsvsimdjs.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlqbmxmZXdzZ2tzZHN2c2ltZGpzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM3NTk4OTgsImV4cCI6MjA3OTMzNTg5OH0.ysDsAdyn3k2i51xnAkJFGKtEWpQ3laxWV7rpjvFIF8E';
    const _supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
    const PIN_SUFFIX = '99'; // igual que index.html

    let currentUser = null;
    let chargers = [], users = [], ads = [];

    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }
    function normalize(str) { return (str || '').toString().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
    function fmtDate(d) { return d ? new Date(d).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) : '–'; }
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }
    function val(id) { return document.getElementById(id).value.trim(); }
    function setVal(id, v) { document.getElementById(id).value = v ?? ''; }

    // ================= ACCESO =================
    async function init() {
        const { data: { session } } = await _supabase.auth.getSession();
        currentUser = session?.user || null;
        if (location.hash.includes('access_token') || location.search.includes('code=')) history.replaceState(null, '', location.pathname);
        if (!currentUser) return showLogin();

        const { data: profile } = await _supabase.from('profiles').select('full_name, role').eq('id', currentUser.id).single();
        if (profile?.role !== 'admin') return showLogin('Tu cuenta no tiene permisos de administrador.');

        document.getElementById('admin-name').innerText = profile.full_name || currentUser.email;
        document.getElementById('btn-logout').classList.remove('hidden');
        document.getElementById('login-view').classList.add('hidden');
        document.getElementById('admin-view').classList.remove('hidden');
        loadChargers(); loadUsers(); loadAds(); loadVisits(); loadReports(); loadMarketAdmin();
    }

    function showLogin(msg) {
        document.getElementById('admin-view').classList.add('hidden');
        document.getElementById('login-view').classList.remove('hidden');
        if (msg) document.getElementById('login-msg').innerText = msg;
        document.getElementById('btn-logout').classList.toggle('hidden', !currentUser);
    }

    document.getElementById('form-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const pin = val('login-pin');
        if (!pin) return alert('Escribe tu PIN o contraseña');
        // 4 dígitos = PIN; cualquier otro texto = contraseña completa
        const password = /^\d{4}$/.test(pin) ? pin + PIN_SUFFIX : pin;
        const { error } = await _supabase.auth.signInWithPassword({ email: val('login-email'), password });
        if (error) alert('Correo o PIN/contraseña incorrecto'); else init();
    });

    async function loginWithGoogle() {
        const { error } = await _supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: window.location.origin + window.location.pathname } });
        if (error) alert(error.message);
    }
    async function logout() { await _supabase.auth.signOut(); location.reload(); }

    _supabase.auth.onAuthStateChange((event, session) => {
        if (event === 'SIGNED_IN' && session?.user?.id !== currentUser?.id) init();
    });

    // Pestañas
    document.querySelectorAll('.tab-btn').forEach(btn => btn.addEventListener('click', () => {
