    function rejectListing(id) {
        const note = prompt('Motivo del rechazo (lo verá el usuario):', '');
        if (note === null) return;
        setListing(id, 'rechazado', note.trim().slice(0, 300) || null);
    }
    async function deleteListing(id) {
        const l = marketItems.find(x => x.id === id);
        if (!confirm(`¿Eliminar "${l?.title}"? También se borrarán sus imágenes.`)) return;
        const paths = (l?.images || []).map(u => u.split('/storage/v1/object/public/market/')[1]).filter(Boolean);
        if (paths.length) await _supabase.storage.from('market').remove(paths);
        const { error } = await _supabase.from('market_listings').delete().eq('id', id);
        if (error) alert(error.message); else if (l?.status === 'aprobado') rebuildSite();
        loadMarketAdmin();
    }
    function openListingForm(id) {
        const l = marketItems.find(x => x.id === id);
        setVal('l-id', l.id); setVal('l-kind', l.kind); setVal('l-cat', l.category); setVal('l-title', l.title);
        setVal('l-price', l.price); setVal('l-city', l.city); setVal('l-desc', l.description);
        document.getElementById('l-company').checked = l.is_company; setVal('l-company-name', l.company_name);
        setVal('l-status', l.status); setVal('l-note', l.admin_note);
        openModal('modal-listing');
    }
    document.getElementById('form-listing').addEventListener('submit', async (e) => {
        e.preventDefault();
        const price = val('l-price');
        const payload = {
            kind: val('l-kind'), category: val('l-cat'), title: val('l-title'), price: price === '' ? null : parseFloat(price),
            city: val('l-city') || null, description: val('l-desc') || null,
            is_company: document.getElementById('l-company').checked, company_name: val('l-company-name') || null,
            status: val('l-status'), admin_note: val('l-note') || null
        };
        const { error } = await _supabase.from('market_listings').update(payload).eq('id', val('l-id'));
        if (error) return alert(error.message);
        if (payload.status === 'aprobado') rebuildSite();
        closeModal('modal-listing'); loadMarketAdmin();
    });

    init();
</script>
</body>
</html>
