            if (!res.ok) throw new Error(data.error || 'Error del asistente');
            out.innerHTML = `<p class="whitespace-pre-line">🤖 ${escapeHtml(data.answer)}</p>
                <p class="text-[11px] text-slate-500 mt-2">${data.from_faq ? '📚 Basado en la comunidad: ' + data.related.map(r => escapeHtml(r.q)).join(' · ') : 'ℹ️ Respuesta general (no está en las preguntas de la comunidad). Verifica antes de decidir.'}</p>`;
        } catch (err) {
            out.innerHTML = `⚠️ ${escapeHtml(err.message)}`;
        } finally { btn.disabled = false; }
    }

    // ================= PLANIFICADOR =================
    // Autonomía real aproximada (km al 100%) — referencial, ajustable
    // [modelo, autonomía real en carretera plana a ~90 km/h (km), batería útil (kWh), peso con 2 personas (kg)]
    // BYD: consumos de pruebas reales (ver tabla de autonomías); otros: referenciales
    const VEHICLES = [
        ['BYD Seagull 300', 235, 30.08, 1300], ['BYD Seagull 400', 300, 38.88, 1350], ['BYD Dolphin', 290, 44.9, 1550],
        ['BYD Yuan Pro', 280, 45.1, 1600], ['BYD Yuan Plus', 350, 60.48, 1900], ['BYD Sealion 7', 400, 82.56, 2350],
        ['BYD Seal', 450, 82.56, 2150], ['BYD Han', 450, 85.4, 2200],
        ['Kia EV5', 380, 64, 2050], ['Kia EV6', 430, 77.4, 2100], ['Kia Niro EV', 400, 64.8, 1850], ['Kia Soul EV', 380, 64, 1800],
        ['Hyundai Kona EV', 400, 64, 1850], ['Hyundai Ioniq 5', 410, 77.4, 2100], ['MG4', 390, 64, 1800], ['MG ZS EV', 300, 51, 1700],
        ['JAC E10X', 230, 31, 1250], ['JAC E-JS4', 320, 55, 1750], ['Renault Kwid E-Tech', 200, 26.8, 1100], ['GWM Ora 03', 300, 48, 1650],
        ['Volvo EX30', 330, 51, 1900], ['Tesla Model 3', 420, 60, 1900], ['Tesla Model Y', 390, 60, 2100], ['Nissan Leaf (40 kWh)', 240, 40, 1700],
        ['Otro (escribe tu autonomía)', 0, 0, 1700]
    ];
    // Energía por desnivel (kWh): subir cuesta m·g·h / 0.85 (eficiencia del motor).
    // Al bajar, la gravedad reemplaza al motor (ahorro casi total); solo lo que hay que frenar se regenera al ~60%.
    const potKwh = (mass, meters) => mass * 9.81 * meters / 3.6e6;
    const climbKwh = (mass, meters) => potKwh(mass, meters) / 0.85;
    const descentKwh = (mass, meters) => 0.85 * potKwh(mass, meters); // ahorro típico en un viaje largo de bajada
    $('p-model').innerHTML = VEHICLES.map((v, i) => `<option value="${i}">${v[0]}${v[1] ? ` (~${v[1]} km)` : ''}</option>`).join('');
    function presetModel() {
        const v = VEHICLES[$('p-model').value];
        $('p-range').value = v[1] || '';
        if (!v[1]) $('p-range').focus();
    }
    presetModel();

    let routeMap = null, routeLayer = null, allChargers = null;
    async function geocode(q) {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=ec&q=${encodeURIComponent(q)}`);
        const r = await res.json();
        if (!r.length) throw new Error(`No encontré "${q}" en Ecuador.`);
        return [parseFloat(r[0].lat), parseFloat(r[0].lon)];
    }
    const kmBetween = (a, b) => {
        const R = 6371, r = Math.PI / 180, dLat = (b[0] - a[0]) * r, dLng = (b[1] - a[1]) * r;
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLng / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(h));
    };
    const maxKw = (p) => Math.max(0, ...[...String(p || '').matchAll(/(\d+(?:[.,]\d+)?)\s*kw/gi)].map(m => parseFloat(m[1].replace(',', '.'))));
    function connOk(c, conn) {
        if (!conn) return true;
        const t = normalize(c.charger_type).replace(/\s+/g, ' ');
        const map = { 'tipo 2': /tipo 2/, 'tipo 1': /tipo 1|cs1/, 'ccs2': /ccs2|css2|cs2/, 'gbt': /gbt|gb\/t/, 'chademo': /chademo/ };
        return map[conn].test(t) || /tomacorriente|toma 2/.test(t); // tomacorriente: con cargador portátil
    }

    // Perfil de altura (área) con la batería estimada (línea) a lo largo del trayecto
    function profileSvg(elev, battAt) {
        const W = 600, H = 120, max = Math.max(...elev, 100), n = elev.length - 1;
        const x = (i) => (i / n * W).toFixed(1);
        const area = `M0,${H} ` + elev.map((e, i) => `L${x(i)},${(H - e / max * (H - 10)).toFixed(1)}`).join(' ') + ` L${W},${H} Z`;
        const line = battAt.map((b, i) => `${i ? 'L' : 'M'}${x(i)},${(H - Math.max(0, b) / 100 * (H - 10)).toFixed(1)}`).join(' ');
        return `<div class="bg-white border border-slate-200 rounded-xl p-3">
            <div class="flex justify-between text-[11px] text-slate-500 mb-1"><span>⛰️ Altura del camino (máx. ${Math.round(max).toLocaleString('es-EC')} m)</span><span class="text-green-700 font-semibold">— Batería estimada</span></div>
            <svg viewBox="0 0 ${W} ${H}" class="w-full h-24" preserveAspectRatio="none" role="img" aria-label="Perfil de altura y batería">
                <path d="${area}" fill="#cbd5e1" /><path d="${line}" fill="none" stroke="#16a34a" stroke-width="2.5" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="flex justify-between text-[10px] text-slate-400"><span>Origen · ${Math.round(battAt[0])}%</span><span>Destino · ${Math.round(battAt[battAt.length - 1])}%</span></div></div>`;
    }

    async function planTrip() {
        const from = $('p-from').value.trim(), to = $('p-to').value.trim();
        const range = +$('p-range').value, start = +$('p-batt').value || 100;
        const out = $('p-out');
        if (!from || !to) return alert('Escribe origen y destino.');
        if (!range) return alert('Escribe la autonomía real de tu carro al 100%.');
        const btn = $('btn-plan'); btn.disabled = true; btn.innerText = 'Calculando ruta…';
        out.classList.remove('hidden'); out.innerHTML = '<p class="text-sm text-slate-500 animate-pulse">Buscando la ruta…</p>';
        try {
            const [a, b] = await Promise.all([geocode(from + ', Ecuador'), geocode(to + ', Ecuador')]);
            const res = await fetch(`https://router.project-osrm.org/route/v1/driving/${a[1]},${a[0]};${b[1]},${b[0]}?overview=full&geometries=geojson`);
            const route = (await res.json()).routes?.[0];
            if (!route) throw new Error('No se encontró una ruta en carretera entre esos lugares.');
            const dist = route.distance / 1000, hours = route.duration / 3600;
            const coords = route.geometry.coordinates.map(([lng, lat]) => [lat, lng]);

            const f = (+$('p-speed').value) * ($('p-ac').checked ? 1.05 : 1);
            const veh = VEHICLES[$('p-model').value];
            const cap = veh[2] || range * 0.15, mass = veh[3];
            const pctPerKm = f / range * 100; // % de batería por km en plano

            // Perfil de altura real de la ruta (Open-Meteo, hasta 100 puntos)
            const idx = Array.from({ length: Math.min(100, coords.length) }, (_, i) => Math.round(i * (coords.length - 1) / (Math.min(100, coords.length) - 1)));
            let elev = null;
            try {
                const er = await fetch(`https://api.open-meteo.com/v1/elevation?latitude=${idx.map(i => coords[i][0].toFixed(4)).join(',')}&longitude=${idx.map(i => coords[i][1].toFixed(4)).join(',')}`);
                const raw = (await er.json()).elevation;
                // Suaviza el ruido del modelo de terreno (media móvil de 5 puntos) para no sumar subidas/bajadas falsas
                elev = raw.map((_, i) => { const w = raw.slice(Math.max(0, i - 2), i + 3); return w.reduce((s, v) => s + v, 0) / w.length; });
                elev[0] = raw[0]; elev[elev.length - 1] = raw[raw.length - 1];
            } catch (e) { elev = null; }
            // Batería a lo largo del trayecto
            const segKm = [0]; for (let i = 1; i < idx.length; i++) segKm.push(segKm[i - 1] + kmBetween(coords[idx[i - 1]], coords[idx[i]]));
            const kmScale = dist / (segKm[segKm.length - 1] || 1);
            let batt = start, up = 0, down = 0, lowKm = null; const battAt = [start];
            for (let i = 1; i < idx.length; i++) {
                const km = (segKm[i] - segKm[i - 1]) * kmScale;
                let used = km * pctPerKm;
                if (elev) {
                    const dh = elev[i] - elev[i - 1];
                    if (dh > 0) { up += dh; used += climbKwh(mass, dh) / cap * 100; }
                    else if (dh < 0) {
                        down -= dh;
                        const flatKwh = used / 100 * cap, pot = potKwh(mass, -dh);
                        const offset = Math.min(pot, flatKwh);            // la gravedad cubre lo que gastaría el motor
                        const kwh = flatKwh - offset - 0.6 * (pot - offset); // el exceso se frena y se regenera al 60%
                        used = kwh / cap * 100;
                    }
                }
                batt = Math.min(100, batt - used); battAt.push(batt);
                if (lowKm === null && batt < 20) lowKm = segKm[i] * kmScale;
            }
            const need = start - batt, arrive = batt, eff = need > 0 ? dist / need * 100 : range;
            let verdict;
            if (arrive >= 20) verdict = `<p class="text-green-700 font-bold">✅ Llegas sin problema, con ~${Math.round(arrive)}% de batería.</p>`;
            else if (arrive >= 0) verdict = `<p class="text-amber-600 font-bold">⚠️ Llegas justo (~${Math.round(arrive)}%). Baja la velocidad, apaga el clima o carga unos minutos en ruta.</p>`;
            else verdict = `<p class="text-red-600 font-bold">❌ No llegas directo: te faltan ~${Math.round(-arrive)}% (≈${Math.round(-arrive / 100 * eff)} km). Planifica una carga.</p>`;

            // Cargadores a menos de 3 km de la ruta, con su km aproximado en el trayecto
            if (!allChargers) {
                const { data } = await _supabase.from('chargers').select('id,title,city,charger_type,power,lat,lng,status,requires_app');
                allChargers = (data || []).filter(c => c.lat && c.lng);
            }
            const step = Math.max(1, Math.floor(coords.length / 1500));
            const sample = coords.filter((_, i) => i % step === 0);
            const cum = [0]; for (let i = 1; i < sample.length; i++) cum.push(cum[i - 1] + kmBetween(sample[i - 1], sample[i]));
            const scale = dist / (cum[cum.length - 1] || 1);
            const conn = $('p-conn').value;
            const onRoute = [];
            for (const c of allChargers) {
                if (c.status === 'NO DISPONIBLE' || !connOk(c, conn)) continue;
                let best = Infinity, at = 0;
                for (let i = 0; i < sample.length; i++) { const d = kmBetween([c.lat, c.lng], sample[i]); if (d < best) { best = d; at = i; } }
                if (best <= 3) onRoute.push({ ...c, off: best, km: cum[at] * scale, fast: maxKw(c.power) >= 50 });
            }
            onRoute.sort((x, y) => x.km - y.km);

            // Sugerencia de parada: último cargador antes de bajar a ~20%
            let stopHTML = '';
            if (arrive < 20) {
                const kmLimit = lowKm ?? Math.max(0, (start - 20) / 100 * eff);
                const cands = onRoute.filter(c => c.km <= kmLimit && c.km > 15);
                const stop = cands.filter(c => c.fast).pop() || cands.pop();
                stopHTML = stop
                    ? `<p class="text-sm">👉 Sugerencia: carga en <b>${escapeHtml(stop.title)}</b> (${escapeHtml(stop.city || '')}), km ${Math.round(stop.km)} del trayecto${stop.fast ? ' · ⚡ carga rápida' : ''}.</p>`
                    : `<p class="text-sm">👉 Carga hasta ~80% antes del km ${Math.round(kmLimit)}. No hay cargadores compatibles registrados en ese tramo: revisa el mapa general.</p>`;
            }

            out.innerHTML = `<div class="grid grid-cols-3 gap-2 text-center">
                    <div class="bg-slate-50 rounded-xl p-2"><p class="lbl">Distancia</p><p class="text-lg font-bold">${Math.round(dist)} km</p></div>
                    <div class="bg-slate-50 rounded-xl p-2"><p class="lbl">Tiempo</p><p class="text-lg font-bold">${Math.floor(hours)}h ${Math.round(hours % 1 * 60)}m</p></div>
                    <div class="bg-slate-50 rounded-xl p-2"><p class="lbl">Batería al llegar</p><p class="text-lg font-bold ${arrive < 0 ? 'text-red-600' : arrive < 20 ? 'text-amber-600' : 'text-green-700'}">${Math.round(arrive)}%</p></div>
                </div>
                <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-1">${verdict}${stopHTML}<p class="text-[11px] text-slate-400">${elev ? `Desnivel del camino: ⬆️ sube ${Math.round(up).toLocaleString('es-EC')} m · ⬇️ baja ${Math.round(down).toLocaleString('es-EC')} m (de ${Math.round(elev[0])} a ${Math.round(elev[elev.length - 1])} m s.n.m.). ` : 'No se pudo obtener la altura del camino; cálculo en plano. '}Autonomía efectiva en esta ruta: ~${Math.round(eff)} km.</p></div>
                ${elev ? profileSvg(elev, battAt) : ''}`;

            // Mapa con ruta y cargadores
            $('route-map').classList.remove('hidden');
            if (!routeMap) {
                routeMap = L.map('route-map', { scrollWheelZoom: false });
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(routeMap);
            }
            if (routeLayer) routeLayer.remove();
            routeLayer = L.featureGroup().addTo(routeMap);
            L.polyline(coords, { color: '#16a34a', weight: 5, opacity: 0.85 }).addTo(routeLayer);
            L.marker(a, { title: from }).addTo(routeLayer).bindPopup('Origen: ' + escapeHtml(from));
            L.marker(b, { title: to }).addTo(routeLayer).bindPopup('Destino: ' + escapeHtml(to));
            onRoute.forEach(c => L.marker([c.lat, c.lng], { icon: L.divIcon({ className: '', html: `<div class="marker-dot" style="background:${c.fast ? '#2563eb' : '#16a34a'}"></div>`, iconSize: [14, 14] }) })
                .addTo(routeLayer).bindPopup(`<b>${escapeHtml(c.title)}</b><p class="text-xs">${escapeHtml(c.power || '')} · ${escapeHtml(c.charger_type || '')}</p><p class="text-xs">Km ${Math.round(c.km)} del trayecto</p>`));
            setTimeout(() => { routeMap.invalidateSize(); routeMap.fitBounds(routeLayer.getBounds().pad(0.05)); }, 50);

            $('p-chargers').innerHTML = onRoute.length
                ? `<p class="text-sm font-bold text-slate-700">⚡ ${onRoute.length} cargadores en la ruta${conn ? ' compatibles' : ''} (a menos de 3 km)</p>` + onRoute.map(c => `
                    <div class="flex justify-between items-center gap-2 bg-slate-50 border border-slate-100 rounded-lg px-3 py-2 text-sm">
                        <div class="min-w-0"><p class="font-semibold truncate">${c.fast ? '⚡ ' : ''}${escapeHtml(c.title)}</p><p class="text-[11px] text-slate-500 truncate">${escapeHtml(c.city || '')} · ${escapeHtml(c.power || '')} · ${escapeHtml(c.charger_type || '')}${c.requires_app ? ' · App ' + escapeHtml(c.requires_app) : ''}</p></div>
                        <span class="text-xs font-bold text-slate-600 whitespace-nowrap">km ${Math.round(c.km)}</span>
                    </div>`).join('')
                : '<p class="text-sm text-slate-500">No hay cargadores registrados a menos de 3 km de esta ruta' + (conn ? ' con tu conector' : '') + '.</p>';
        } catch (err) {
            out.innerHTML = `<p class="text-sm text-red-600">⚠️ ${escapeHtml(err.message)}</p>`;
        } finally { btn.disabled = false; btn.innerText = 'Planificar ruta'; }
    }

    // ================= CALCULADORA =================
    const REDES = { conectz: { kwh: 0.17, act: 4, pmin: 0.10 }, ecored: { kwh: 0.2851, act: 0, pmin: 0 }, mevo: { kwh: 0.28, act: 0, pmin: 0 }, primax: { kwh: 0, act: 7, pmin: 0 }, casa: { kwh: 0.06, act: 0, pmin: 0 }, manual: {} };
    function presetRed() {
        const r = REDES[$('c-red').value] || {};
        if (r.kwh != null) $('c-pkwh').value = r.kwh; if (r.act != null) $('c-act').value = r.act; if (r.pmin != null) $('c-pmin').value = r.pmin;
        if ($('c-red').value === 'primax') { $('c-kwh').value = 15; $('c-min').value = 32; $('c-km').value = 90; }
    }
    function calcCost() {
        const kwh = +$('c-kwh').value || 0, pkwh = +$('c-pkwh').value || 0, act = +$('c-act').value || 0, min = +$('c-min').value || 0, pmin = +$('c-pmin').value || 0, km = +$('c-km').value || 1;
        const total = kwh * pkwh + act + min * pmin;
        $('c-out').classList.remove('hidden');
        $('c-out').innerHTML = `<p>Costo de la sesión: <b class="text-lg text-green-700">$${total.toFixed(2)}</b></p>
            <p>Costo por 100 km: <b class="text-lg text-green-700">$${(total / km * 100).toFixed(2)}</b></p>
            <p class="text-[11px] text-slate-500">Energía $${(kwh * pkwh).toFixed(2)} + activación $${act.toFixed(2)} + tiempo $${(min * pmin).toFixed(2)}</p>
            ${act >= 4 && min > 0 ? '<p class="text-amber-700 text-xs mt-1">⚠️ Con activación alta evita cargas cortas: el costo fijo se reparte mejor en cargas largas.</p>' : ''}`;
    }
    presetRed();

    // ================= CARGA PROGRAMADA =================
    // [modelo, batería útil kWh, potencia máx. de carga AC del carro kW]
    const BYD_AC = [
        ['BYD Seagull 300', 30.08, 6.6], ['BYD Seagull 400', 38.88, 6.6], ['BYD Dolphin', 44.9, 7], ['BYD Yuan Pro', 45.1, 7],
        ['BYD Yuan Plus', 60.48, 7], ['BYD Sealion 7', 82.56, 11], ['BYD Seal', 82.56, 11], ['BYD Han', 85.4, 7],
        ['BYD Song Plus DM-i (híbrido)', 18.3, 6.6],
    ];
    $('s-model').innerHTML = BYD_AC.map((m, i) => `<option value="${i}">${m[0]} · ${m[1]} kWh · AC ${m[2]} kW</option>`).join('');
    const hhmm = (mins) => { const m = ((Math.round(mins) % 1440) + 1440) % 1440; return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); };
    function calcSmart() {
        const [name, cap, obc] = BYD_AC[$('s-model').value];
        const from = Math.max(0, Math.min(100, +$('s-from').value || 0)), to = Math.max(0, Math.min(100, +$('s-to').value || 0));
        const out = $('s-out');
        if (to <= from) { out.innerHTML = '⚠️ El % objetivo debe ser mayor que el actual.'; return; }
        const power = Math.min(obc, +$('s-source').value);
        const kwhBattery = cap * (to - from) / 100;
        const kwhGrid = kwhBattery / 0.9; // pérdidas de carga ~10%
        // Por encima del 90% la carga se hace más lenta (~70% de la potencia)
        const fast = Math.max(0, Math.min(to, 90) - from), slow = Math.max(0, to - Math.max(from, 90));
        const hours = (cap * fast / 100 / 0.9) / power + (cap * slow / 100 / 0.9) / (power * 0.7);
        const [h, m] = ($('s-start').value || '22:00').split(':').map(Number);
        const end = h * 60 + m + hours * 60;
        const nextDay = end >= 1440 ? ' (del día siguiente)' : '';
        out.innerHTML = `<p>🔌 Potencia de carga: <b>${power} kW</b>${power < +$('s-source').value ? ` <span class="text-xs text-slate-500">(tu ${name} carga máximo a ${obc} kW en AC)</span>` : ''}</p>
            <p>🔋 Energía a cargar: <b>${kwhBattery.toFixed(1)} kWh</b> <span class="text-xs text-slate-500">(${kwhGrid.toFixed(1)} kWh de la red)</span></p>
            <p>⏱️ Duración aproximada: <b>${Math.floor(hours)} h ${Math.round(hours % 1 * 60)} min</b></p>
            <p class="text-base mt-1">🕒 Configura el fin de carga a las <b class="text-green-700 text-xl">${hhmm(end)}</b>${nextDay}</p>
            <p class="text-xs text-slate-500 mt-1">Costo aproximado: $${(kwhGrid * (+$('s-price').value || 0)).toFixed(2)}</p>`;
    }
    calcSmart();

    // ================= APPS RECOMENDADAS =================
    const play = (q) => `https://play.google.com/store/search?q=${encodeURIComponent(q)}&c=apps`;
    const APPS_CARGA = [
        { n: 'Conectz', d: 'Red de Kia pero multimarca; la más usada en carretera. Activas y pagas desde la app (activación + $/min + energía).', links: [['Google Play', play('Conectz')]] },
        { n: 'Evinka', d: 'Activación por QR y saldo prepago.', extra: 'Soporte oficial: 098 830 6287', links: [['Google Play', play('Evinka')], ['WhatsApp soporte', 'https://wa.me/593988306287']] },
        { n: 'Mevo (Enerlink EVX)', d: 'Disponible en Play Store, ~$0.28/kWh. Recomendada por la comunidad.', links: [['Google Play', play('Enerlink EVX')]] },
        { n: 'Condor Charge / Condor Energy', d: 'Red de carga rápida (Mall del Pacífico Manta y más).', links: [['Google Play', 'https://play.google.com/store/apps/details?id=com.tridenstechnology.condorenergy'], ['App Store', 'https://apps.apple.com/ec/app/condor-energy/id6446024808']] },
    ];
    const APPS_AUTO = [
        { n: 'BYD Auto (oficial)', d: 'Vinculación por QR en el concesionario, llave digital NFC y datos del carro (1.5 GB). Sin vincular en el concesionario, la app no funciona.', links: [['Google Play', play('BYD Auto')]] },
    ];
    const appCard = (a) => `<div class="border border-slate-200 rounded-xl p-3">
        <p class="font-bold text-slate-800">${a.n}</p><p class="text-xs text-slate-600 mt-0.5">${a.d}</p>
        ${a.extra ? `<p class="text-xs text-slate-500 mt-0.5">${a.extra}</p>` : ''}
        <div class="flex flex-wrap gap-1.5 mt-2">${a.links.map(([t, u]) => `<a href="${u}" target="_blank" rel="noopener" class="text-[11px] font-bold bg-slate-900 text-white px-2.5 py-1 rounded-full hover:bg-black">${t}</a>`).join('')}</div></div>`;
    $('apps-carga').innerHTML = APPS_CARGA.map(appCard).join('');
    $('apps-auto').innerHTML = APPS_AUTO.map(appCard).join('');

    // ================= DIRECTORIO =================
    // Los números solo se muestran a usuarios registrados
    const DIR = [
        { n: 'Agendamiento BYD (citas/app/soporte)', c: 'Concesionario', t: '593991367638', d: 'Citas, vinculación app BYD Auto y soporte.' },
        { n: 'Llantas 247 Quito', c: 'Llantas', t: '593992475060', d: 'Venta de llantas en Quito.' },
        { n: 'Powercenter Llantas (Manta)', c: 'Llantas', t: '', d: 'Donde compran llantas los de la comunidad en Manta.' },
        { n: 'Soporte EVINKA', c: 'Carga', t: '593988306287', d: 'Soporte oficial red Evinka.' },
        { n: 'Condor Energy', c: 'Carga', t: '593984924820', d: 'Red de carga rápida.' },
    ];
    function renderDir() {
        const sel = $('d-cat');
        if (sel.options.length <= 1) [...new Set(DIR.map(d => d.c))].forEach(c => sel.add(new Option(c, c)));
        const f = sel.value;
        $('dir-list').innerHTML = DIR.filter(d => !f || d.c === f).map(d => `
            <div class="border border-slate-200 rounded-xl p-3">
                <div class="flex justify-between gap-2"><p class="font-semibold text-slate-800 text-sm">${escapeHtml(d.n)}</p><span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full h-fit">${d.c}</span></div>
                <p class="text-xs text-slate-500">${escapeHtml(d.d)}</p>
                ${!d.t ? '<p class="text-[11px] text-slate-400 mt-1">Sin número directo.</p>'
                    : currentUser ? `<a href="https://wa.me/${d.t}?text=${encodeURIComponent('Hola, vengo de la comunidad EvCarga. Quisiera información.')}" target="_blank" rel="noopener" class="inline-block mt-1 text-xs font-bold text-green-700">💬 WhatsApp +${d.t}</a>`
                    : `<button onclick="requireLogin('Ingresa para ver los contactos del directorio.')" class="mt-1 text-xs font-bold text-slate-500 hover:text-green-700">🔒 Ingresa para ver el contacto</button>`}
            </div>`).join('');
    }

    // ================= AUTONOMÍAS Y VIAJES =================
    // [modelo, oficial, ciudad real, carretera real 90–100 km/h, índice en VEHICLES (para subida/bajada), nota/fuente]
    const DB = [
        ['Seagull 300', '305 km NEDC · 30.08 kWh', '~270–290', '~225–245', 0, 'Estimado con el consumo medido del Seagull 400 (misma carrocería, batería menor).'],
        ['Seagull 400', '380 km NEDC (vendido como 400 km) · 38.88 kWh', '~350–365', '~285–310', 1, 'Prueba Autoblog Uruguay: 363 km ciudad, 286 km carretera (10.7 y 13.4 kWh/100 km). Dueños en Uruguay: 280–310 km en carretera.'],
        ['Dolphin', '405 km NEDC · 44.9 kWh', '~320–345', '~280–300', 2, 'Pruebas en Brasil: 280–320 km reales.'],
        ['Yuan Pro', '380 km NEDC · 45.1 kWh', '~310–330', '~270–290', 3, 'Estimado por consumo típico de su tamaño.'],
        ['Yuan Plus', '480 km NEDC · 60.48 kWh', '~390–410', '~340–360', 4, 'Estimado por consumo típico de su tamaño.'],
        ['Sealion 7', '456 km NEDC · 82.56 kWh', '~430–460', '~380–410', 5, 'Comunidad: ~340–350 km en uso mixto en Quito (con subidas).'],
        ['Song Plus DM-i', '~100 km eléctricos · 1.105 km combinada · 18.3 kWh', '~90–100 eléctricos', '~75–85 eléctricos', -1, 'Híbrido enchufable: después sigue con gasolina.'],
    ];
    // Km con batería llena en un viaje que sube o baja 2.800 m (ej. Guayaquil ↔ Quito), a ~90 km/h
    function slopeRange(vi, meters, upHill) {
        if (vi < 0) return '—';
        const [, hwy, cap, mass] = VEHICLES[vi];
        const perKm = cap / hwy;
        const usable = upHill ? cap - climbKwh(mass, meters) : cap + descentKwh(mass, meters);
        return '~' + Math.round(usable / perKm / 5) * 5 + ' km';
    }
    $('db-cards').innerHTML = DB.map(r => `<div class="border border-slate-200 rounded-xl p-3">
        <p class="font-bold text-slate-800">${r[0]}</p><p class="text-[11px] text-slate-500">${r[1]}</p>
        <div class="grid grid-cols-2 gap-1.5 mt-2 text-center">
            <div class="bg-slate-50 rounded-lg p-1.5"><p class="lbl">Ciudad</p><p class="text-sm font-semibold">${r[2]}</p></div>
            <div class="bg-slate-50 rounded-lg p-1.5"><p class="lbl">Carretera</p><p class="text-sm font-semibold">${r[3]}</p></div>
            <div class="bg-amber-50 rounded-lg p-1.5"><p class="lbl">⬆️ Subiendo 2.800 m</p><p class="text-sm font-semibold">${slopeRange(r[4], 2800, true)}</p></div>
            <div class="bg-sky-50 rounded-lg p-1.5"><p class="lbl">⬇️ Bajando 2.800 m</p><p class="text-sm font-semibold">${slopeRange(r[4], 2800, false)}</p></div>
        </div><p class="text-[11px] text-slate-500 mt-1.5">${r[5]}</p></div>`).join('');
    $('db-table').innerHTML = DB.map(r => `<tr class="border-b border-slate-50 align-top">
        <td class="p-2 font-semibold text-slate-800 whitespace-nowrap">${r[0]}</td><td class="p-2 text-xs min-w-[140px]">${r[1]}</td>
        <td class="p-2 whitespace-nowrap">${r[2]}</td><td class="p-2 whitespace-nowrap">${r[3]}</td>
        <td class="p-2 whitespace-nowrap">${slopeRange(r[4], 2800, true)}</td><td class="p-2 whitespace-nowrap">${slopeRange(r[4], 2800, false)}</td>
        <td class="p-2 text-xs text-slate-500 min-w-[200px]">${r[5]}</td></tr>`).join('');
    const SEED_TRIPS = [{ ruta: 'Machala → Cuenca', vel: '—', batt: '100% cargado', costo: 20, tiempo: '48 min al 100%', com: 'Carga rápida, $20.' }];

    async function loadCommunity() {
        const { data } = await _supabase.from('community_posts').select('id,kind,data,user_id,created_at').order('created_at', { ascending: false }).limit(100);
        const posts = data || [];
        const del = (p) => currentUser && (p.user_id === currentUser.id || currentProfile?.role === 'admin') ? `<button onclick="deletePost(${p.id})" class="text-[10px] text-red-500 ml-2">Eliminar</button>` : '';
        const autos = posts.filter(p => p.kind === 'autonomia');
        $('db-user').innerHTML = autos.length ? `<div class="overflow-x-auto"><table class="w-full text-sm"><thead class="text-left text-xs uppercase text-slate-400 border-b"><tr><th class="p-2">Modelo</th><th class="p-2">Zona</th><th class="p-2">Km reales</th><th class="p-2">Nota</th></tr></thead><tbody>${autos.map(p => `<tr class="border-b border-slate-50"><td class="p-2">${escapeHtml(p.data.m)}</td><td class="p-2">${escapeHtml(p.data.z)}</td><td class="p-2">${escapeHtml(p.data.km)}</td><td class="p-2 text-xs">${escapeHtml(p.data.n || '')}${del(p)}</td></tr>`).join('')}</tbody></table></div>` : '<p class="text-sm text-slate-400">Aún no hay aportes. ¡Sé el primero!</p>';
        const trips = posts.filter(p => p.kind === 'viaje').map(p => ({ ...p.data, _p: p })).concat(SEED_TRIPS);
        $('trip-list').innerHTML = trips.map(t => `<div class="border border-slate-200 rounded-xl p-3 text-sm">
            <p class="font-semibold text-slate-800">${escapeHtml(t.ruta)} ${t._p ? del(t._p) : ''}</p>
            <div class="flex flex-wrap gap-1 mt-1 text-[11px]">
                <span class="bg-slate-100 px-2 py-0.5 rounded-full">🔋 ${escapeHtml(t.batt)}</span><span class="bg-slate-100 px-2 py-0.5 rounded-full">💰 $${escapeHtml(t.costo)}</span>
                <span class="bg-slate-100 px-2 py-0.5 rounded-full">🚗 ${escapeHtml(t.vel)} km/h</span><span class="bg-slate-100 px-2 py-0.5 rounded-full">⏱️ ${escapeHtml(t.tiempo)}</span>
            </div>${t.com ? `<p class="text-xs text-slate-500 mt-1">${escapeHtml(t.com)}</p>` : ''}</div>`).join('');
    }

    async function addPost(kind, data) {
        if (!currentUser) { requireLogin('Ingresa para aportar a la comunidad.'); return false; }
        const { error } = await _supabase.from('community_posts').insert([{ kind, data }]);
        if (error) { alert(error.message); return false; }
        loadCommunity(); return true;
    }
    async function addAutonomia() {
        const m = $('d-model').value.trim(), km = +$('d-km').value;
        if (!m || !km) return alert('Completa modelo y km');
        if (await addPost('autonomia', { m, z: $('d-zone').value, km, n: $('d-note').value.trim() })) { ['d-model', 'd-km', 'd-note'].forEach(i => $(i).value = ''); alert('¡Gracias por tu aporte!'); }
    }
    async function addTrip() {
        const ruta = $('t-ruta').value.trim();
        if (!ruta) return alert('Escribe la ruta');
        const d = { ruta, vel: $('t-vel').value || '—', batt: ($('t-batt').value ? $('t-batt').value + '%' : '—'), costo: $('t-costo').value || '—', tiempo: $('t-tiempo').value.trim() || '—', com: $('t-com').value.trim() };
        if (await addPost('viaje', d)) { ['t-ruta', 't-vel', 't-batt', 't-costo', 't-tiempo', 't-com'].forEach(i => $(i).value = ''); alert('¡Reporte publicado!'); }
    }
    async function deletePost(id) {
        if (!confirm('¿Eliminar este aporte?')) return;
        await _supabase.from('community_posts').delete().eq('id', id);
        loadCommunity();
    }

    // ================= INICIO =================
    loadFaq();
    initSession();
</script>
</body>
</html>
