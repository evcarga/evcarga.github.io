        FAQ = data || [];
        $('faq-list').innerHTML = FAQ.map(f => `<details class="py-2"><summary class="cursor-pointer font-semibold text-slate-800">${escapeHtml(f.q)}</summary><p class="mt-1 text-slate-600">${escapeHtml(f.a)}</p></details>`).join('');
