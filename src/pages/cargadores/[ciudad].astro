---
// Página por ciudad: /cargadores/<ciudad>.html (se genera con los datos de Supabase)
import Seo from '../../layouts/Seo.astro';
import { getCities, maxKw } from '../../lib/chargers.js';

export async function getStaticPaths() {
  const cities = await getCities();
  return cities.map((city) => ({ params: { ciudad: city.slug }, props: { city, cities } }));
}

const { city, cities } = Astro.props;
const { name, provincia, chargers } = city;
const n = chargers.length;
const withCoords = chargers.filter((c) => c.lat && c.lng);
const fast = chargers.filter((c) => (maxKw(c.power) || 0) >= 50).length;
const topKw = Math.max(0, ...chargers.map((c) => maxKw(c.power) || 0));

// Ciudades cercanas (distancia en línea recta entre centros)
const center = (list) => {
  const pts = list.filter((c) => c.lat && c.lng);
  return pts.length ? [pts.reduce((s, c) => s + c.lat, 0) / pts.length, pts.reduce((s, c) => s + c.lng, 0) / pts.length] : null;
};
const km = (a, b) => {
  const R = 6371, r = Math.PI / 180;
  const dLat = (b[0] - a[0]) * r, dLng = (b[1] - a[1]) * r;
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
};
const here = center(chargers);
const nearby = here
  ? cities
      .filter((c) => c.slug !== city.slug)
      .map((c) => ({ ...c, dist: center(c.chargers) ? km(here, center(c.chargers)) : Infinity }))
      .sort((a, b) => a.dist - b.dist)
      .slice(0, 6)
  : [];

const lugar = provincia && provincia !== name ? `${name}, ${provincia}` : name;
const title = `Cargadores para carros eléctricos en ${name} (${n}) | EvCarga Ecuador`;
const description = `${n} ${n === 1 ? 'punto de carga' : 'puntos de carga'} para autos eléctricos en ${lugar}${fast ? `, ${fast} de carga rápida` : ''}: ubicación, conector, potencia, horario y precio. Instalación de cargadores en ${name} desde $20 USD.`;
const mapUrl = `/?ciudad=${encodeURIComponent(name)}`;
const mapsLink = (c) => c.link || (c.lat && c.lng ? `https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}` : null);
const price = (v, suf) => (v === null || v === undefined || v === '' || Number(v) === 0 ? 'Gratis' : `$${v}${suf}`);
const whatsapp = `https://wa.me/593980407829?text=${encodeURIComponent(`Hola, quiero cotizar la instalación de un cargador para mi carro eléctrico en ${name}`)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `Cargadores para carros eléctricos en ${name}`,
      url: new URL(`/cargadores/${city.slug}.html`, Astro.site).href,
      inLanguage: 'es-EC',
      isPartOf: { '@id': 'https://evcarga.github.io/#website' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: n,
        itemListElement: chargers.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Place',
            name: c.title,
            address: { '@type': 'PostalAddress', streetAddress: c.address || undefined, addressLocality: name, addressRegion: provincia || undefined, addressCountry: 'EC' },
            ...(c.lat && c.lng ? { geo: { '@type': 'GeoCoordinates', latitude: c.lat, longitude: c.lng } } : {}),
            ...(mapsLink(c) ? { hasMap: mapsLink(c) } : {}),
            description: [c.charger_type, c.power].filter(Boolean).join(' · '),
          },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'EvCarga Ecuador', item: 'https://evcarga.github.io/' },
        { '@type': 'ListItem', position: 2, name: 'Ciudades', item: 'https://evcarga.github.io/cargadores.html' },
        { '@type': 'ListItem', position: 3, name },
      ],
    },
  ],
};
---
<Seo title={title} description={description} path={`/cargadores/${city.slug}.html`} jsonLd={jsonLd} withMap={withCoords.length > 0}>
    <header class="bg-slate-900 text-white py-10 px-4">
        <div class="container mx-auto max-w-4xl">
            <p class="text-xs text-slate-400 mb-2"><a href="/" class="hover:text-white">Inicio</a> › <a href="/cargadores.html" class="hover:text-white">Ciudades</a> › {name}</p>
            <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Cargadores para carros eléctricos en {name}</h1>
            <p class="text-slate-300">{description}</p>
            <div class="flex flex-wrap gap-3 mt-5 text-sm">
                <span class="bg-white/10 px-3 py-1.5 rounded-lg"><b>{n}</b> {n === 1 ? 'punto de carga' : 'puntos de carga'}</span>
                {fast > 0 && <span class="bg-white/10 px-3 py-1.5 rounded-lg"><b>{fast}</b> de carga rápida (50 kW o más)</span>}
                {topKw > 0 && <span class="bg-white/10 px-3 py-1.5 rounded-lg">Hasta <b>{topKw} kW</b></span>}
            </div>
        </div>
    </header>

    <main class="container mx-auto max-w-4xl px-4 -mt-4">
        {withCoords.length > 0 && (
            <div id="city-map" class="h-72 w-full rounded-2xl shadow-lg border border-slate-200 mb-6 z-0" aria-label={`Mapa de cargadores en ${name}`}></div>
        )}

        <h2 class="text-xl font-bold text-slate-800 mb-3">Puntos de carga en {name}</h2>
        <div class="grid md:grid-cols-2 gap-4">
            {chargers.map((c) => (
                <article class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                    <h3 class="font-bold text-slate-800 leading-snug">{c.title}</h3>
                    {c.status === 'NO DISPONIBLE' && <p class="text-[11px] font-bold text-red-600 mt-0.5">⛔ No sirve por el momento</p>}
                    {c.address && <p class="text-xs text-slate-500 mt-0.5">{c.address}</p>}
                    <dl class="grid grid-cols-2 gap-x-3 gap-y-1 text-sm mt-3">
                        <dt class="text-slate-400">Conector</dt><dd class="text-slate-800">{c.charger_type || 'No especificado'}</dd>
                        <dt class="text-slate-400">Potencia</dt><dd class="text-slate-800">{c.power || 'No especificado'}</dd>
                        {c.schedule && <><dt class="text-slate-400">Horario</dt><dd class="text-slate-800">{c.schedule}</dd></>}
                        <dt class="text-slate-400">Precio</dt><dd class="text-slate-800">{price(c.price_kwh, '/kWh')}</dd>
                    </dl>
                    {mapsLink(c) && <a href={mapsLink(c)} target="_blank" rel="noopener" class="inline-block mt-3 text-sm font-bold text-blue-600 hover:underline">Cómo llegar →</a>}
                </article>
            ))}
        </div>

        <section class="bg-white rounded-2xl p-6 border border-green-200 shadow-sm mt-8">
            <h2 class="text-xl font-bold text-slate-800 mb-2">Instalación de cargadores para carros eléctricos en {name}</h2>
            <p class="text-sm leading-relaxed mb-4">¿Tienes un auto eléctrico en {lugar}? Instalamos tu cargador en casa, edificio o negocio <b>desde $20 USD</b>: wallbox Tipo 1 y Tipo 2, tomacorriente 220V 32A y adecuación de la instalación eléctrica.</p>
            <a href={whatsapp} target="_blank" rel="noopener" class="inline-flex bg-green-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-green-700 shadow">Cotizar instalación por WhatsApp</a>
        </section>

        {nearby.length > 0 && (
            <section class="mt-8">
                <h2 class="text-xl font-bold text-slate-800 mb-3">Cargadores en ciudades cercanas a {name}</h2>
                <div class="flex flex-wrap gap-2">
                    {nearby.map((c) => (
                        <a href={`/cargadores/${c.slug}.html`} class="bg-white border border-slate-200 rounded-full px-4 py-2 text-sm hover:border-green-500 hover:text-green-700">
                            {c.name} <span class="text-slate-400">· {c.chargers.length} · {Number.isFinite(c.dist) ? `${Math.round(c.dist)} km` : ''}</span>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>

    <!-- Botón fijo hacia el mapa principal, filtrado por esta ciudad -->
    <div class="fixed bottom-0 inset-x-0 z-[1000] p-3 bg-gradient-to-t from-white via-white/95 to-transparent">
        <a href={mapUrl} class="block max-w-md mx-auto bg-green-600 text-white text-center py-3.5 rounded-xl font-bold shadow-xl hover:bg-green-700 transition">
            Ver mapa completo en EvCarga →
        </a>
    </div>

    {withCoords.length > 0 && (
        <>
            <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            <script is:inline define:vars={{ pts: withCoords.map((c) => [c.lat, c.lng, c.title]) }}>
                const map = L.map('city-map', { scrollWheelZoom: false });
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap', maxZoom: 19,
                }).addTo(map);
                const markers = pts.map(([lat, lng, t]) => L.marker([lat, lng], { title: t }).addTo(map).bindPopup(t.replace(/</g, '&lt;')));
                map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3), { maxZoom: 15 });
            </script>
        </>
    )}
</Seo>
